# Qualcomm (QDL/Sahara/Firehose) - vendor 05c6
SUBSYSTEM=="usb", ATTR{idVendor}=="05c6", MODE="0666", GROUP="plugdev"

# Qualcomm 9008 EDL mode (QCS6490)
SUBSYSTEM=="usb", ATTR{idVendor}=="05c6", ATTR{idProduct}=="9008", MODE="0666", GROUP="plugdev"

# Qualcomm DIAG/serial
SUBSYSTEM=="usb", ATTR{idVendor}=="05c6", ATTR{idProduct}=="9091", MODE="0666", GROUP="plugdev"

# Qualcomm 9018 - QCS6490 fastboot/EDL
SUBSYSTEM=="usb", ATTR{idVendor}=="05c6", ATTR{idProduct}=="9018", MODE="0666", GROUP="plugdev"

# Android ADB/Fastboot
SUBSYSTEM=="usb", ATTR{idVendor}=="18d1", MODE="0666", GROUP="plugdev"
SUBSYSTEM=="usb", ATTR{idVendor}=="2717", MODE="0666", GROUP="plugdev"

# Generic Android USB
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", MODE="0666", GROUP="plugdev"
