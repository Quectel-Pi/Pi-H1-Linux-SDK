+ * byte per pixel, chroma is an interleaved pair, which is what DRM_FORMAT_GR88
+ * means. */
+#define VENUS_DRM_FORMAT_R8 \
+    VENUS_FOURCC('R', '8', ' ', ' ')
+#define VENUS_DRM_FORMAT_GR88 \
+    VENUS_FOURCC('G', 'R', '8', '8')
