+#ifndef __ANDROID__
+static void linux_reboot_via_shell(const char *arg)
+{
+    char buf[128];
+    if (snprintf(buf, sizeof(buf), "/sbin/reboot %s", arg ? arg : "") >= (int)sizeof(buf))
+        return;
+    sync();
+    system(buf);
+}
+#endif
 
