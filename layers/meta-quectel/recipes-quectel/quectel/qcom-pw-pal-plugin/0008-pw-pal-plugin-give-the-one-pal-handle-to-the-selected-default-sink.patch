+        pw_pal_retry_disarm(udata);
+        return;
+    }
+
     rc = pw_pal_stream_open_start(udata);
     if (rc == 0) {
         pw_log_info("pal_stream_start succeeded on retry, %u attempts left",
@@ -498,6 +674,16 @@
         pw_log_error("pal_stream_start failed (%d), no ACDB graph for this device/instance, giving up",
                 rc);
         pw_pal_retry_disarm(udata);
+    } else if (rc == -EAGAIN) {
+        /*
+         * Another direction-mate still holds the one instance. That is the
+         * handover in flight, not a failure: keep the timer armed and never let
