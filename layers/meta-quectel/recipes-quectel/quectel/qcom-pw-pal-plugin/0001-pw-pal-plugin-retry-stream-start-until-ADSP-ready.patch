+/*
+ * The first PAL graph open of a session can fail while the ADSP audio PD is
+ * still coming up: gsl_graph_open_sgids_and_connections() hits the GSL wait,
+ * pal_stream_start() returns -110 (ETIMEDOUT) / -68, and PAL does not
+ * re-initialise by itself. This plugin used to close the stream and return,
+ * but the stream state callback only fires on a state *transition*, so the
+ * sink stayed silent for the rest of the session while PipeWire kept
+ * consuming buffers (the player never sees an error). Retry the start from
+ * the main loop instead, until the ADSP answers.
+ */
+#define PAL_START_RETRY_INTERVAL_MS 2000
+#define PAL_START_RETRY_ATTEMPTS    90      /* 3 min, ADSP was ready in <= 2.5 */
+
 struct pw_userdata {
     struct pw_context *context;
 
@@ -80,6 +94,9 @@ struct pw_userdata {
 
     int jack_fd;
     char jack_name[MAX_NAME_LENGTH];
