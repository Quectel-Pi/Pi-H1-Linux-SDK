+}
+
+static void pw_pal_retry_timer_func(void *data, uint64_t expirations)
+{
+    struct pw_userdata *udata = data;
+    int rc;
 
+    if (udata->retry_left == 0) {
+        pw_pal_retry_disarm(udata);
+        return;
+    }
+    udata->retry_left--;
+
+    /* A previous attempt (or a new stream) already got the handle up. */
+    if (udata->stream_handle != NULL) {
+        pw_pal_retry_disarm(udata);
+        return;
+    }
+
+    rc = pw_pal_stream_open_start(udata);
+    if (rc == 0) {
+        pw_log_info("pal_stream_start succeeded on retry, %u attempts left",
+                udata->retry_left);
+        pw_pal_retry_disarm(udata);
+    } else if (udata->retry_left == 0) {
+        pw_log_error("pal_stream_start still failing (%d) after %d attempts, giving up",
+                rc, PAL_START_RETRY_ATTEMPTS);
+    } else {
+        pw_log_error("pal_stream_start retry failed (%d), %u attempts left",
+                rc, udata->retry_left);
+    }
+}
+
+static void pw_pal_retry_arm(struct pw_userdata *udata)
+{
+    struct timespec interval = {
+        PAL_START_RETRY_INTERVAL_MS / 1000,
+        (PAL_START_RETRY_INTERVAL_MS % 1000) * 1000000,
+    };
+    struct pw_loop *loop = pw_context_get_main_loop(udata->context);
+
+    if (loop == NULL)
+        return;
+    if (udata->retry_timer == NULL) {
+        udata->retry_timer = pw_loop_add_timer(loop, pw_pal_retry_timer_func, udata);
+        if (udata->retry_timer == NULL) {
+            pw_log_error("could not create the pal_stream_start retry timer");
+            return;
+        }
+    }
+    udata->retry_left = PAL_START_RETRY_ATTEMPTS;
+    pw_loop_update_timer(loop, udata->retry_timer, &interval, &interval, false);
+}
+
+static void pw_pal_stream_start(struct pw_userdata *udata)
+{
+    int rc = pw_pal_stream_open_start(udata);
+
+    if (rc) {
+        pw_log_error("stream start failed (%d), retrying every %d ms (up to %d attempts)",
+                rc, PAL_START_RETRY_INTERVAL_MS, PAL_START_RETRY_ATTEMPTS);
+        pw_pal_retry_arm(udata);
+    }
 }
 static void pw_pal_change_stream_state(void *d, enum pw_stream_state old,
         enum pw_stream_state state, const char *error)
@@ -191,9 +277,11 @@ static void pw_pal_change_stream_state(void *d, enum pw_stream_state old,
