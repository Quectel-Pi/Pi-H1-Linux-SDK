+static void pw_pal_retry_disarm(struct pw_userdata *udata)
+{
+    struct timespec zero = { 0, 0 };
+
+    udata->retry_left = 0;
+    if (udata->retry_timer)
+        pw_loop_update_timer(pw_context_get_main_loop(udata->context),
+                udata->retry_timer, &zero, &zero, false);
+}
