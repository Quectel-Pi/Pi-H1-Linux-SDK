+/*
+ * Which evdev switch bit means "this jack is plugged". The headset jack is an
+ * SND_JACK_HEADSET device (SW_HEADPHONE_INSERT | SW_MICROPHONE_INSERT), the
+ * HDMI/DP jacks are SND_JACK_AVOUT (SW_LINEOUT_INSERT) -- see
+ * jack_switch_types[] in sound/core/jack.c and qcm6490_dai_* in
+ * sound/soc/qcom/qcm6490.c. Each input device only ever reports its own jack's
+ * bits, so reading "any of them set" here is unambiguous.
+ */
+#define JACK_SWITCH_BITS \
+    ((1u << SW_HEADPHONE_INSERT) | (1u << SW_MICROPHONE_INSERT) | (1u << SW_LINEOUT_INSERT))
+#define IS_JACK_SWITCH(code) \
+    (code < 32 && (((JACK_SWITCH_BITS) >> (code)) & 1u))
+
+static bool jack_plugged(const uint8_t *sw_bitmask)
+{
+    return BIT_VALUE(SW_LINEOUT_INSERT, sw_bitmask) ||
+        BIT_VALUE(SW_HEADPHONE_INSERT, sw_bitmask) ||
+        BIT_VALUE(SW_MICROPHONE_INSERT, sw_bitmask);
+}
+
+/*
+ * Show/hide the node of a jacked instance. Upstream created one stream per
+ * module instance at module_init, so every sink/source showed up in the session
+ * manager whether or not its device was plugged in. Nothing can hide a node
+ * from outside: pipewire has no "hidden" property, wireplumber's disable keys
+ * only apply to monitor-created nodes, and destroying an instance's module at
+ * runtime takes the module (and its jack fd) with it, so the node never came
+ * back. Owning the stream here is the only place that can do it.
+ *
+ * The stream is cheap to create late: it is just pw_stream_new() + connect(),
+ * the PAL graph is only opened on the first STREAMING, which already retries
+ * until the ADSP answers.
+ */
+static int pw_pal_set_stream_visible(struct pw_userdata *udata, bool visible)
+{
+    int res;
+
+    if (visible) {
+        if (udata->stream)
+            return 0;
+        if ((res = pw_pal_create_stream(udata)) < 0) {
+            pw_log_error("%s: could not create the stream (%d)",
+                    udata->jack_name, res);
+            return res;
+        }
+        pw_log_info("%s: node created", udata->jack_name);
+        return 0;
+    }
+
+    if (udata->stream == NULL)
+        return 0;
+
+    pw_pal_retry_disarm(udata);
+    close_pal_stream(udata);
+    /*
+     * pw_stream_destroy() emits .destroy (which clears udata->stream) but no
+     * state change, so the UNCONNECTED branch in pw_pal_change_stream_state()
+     * does not fire and the module survives with its jack fd intact.
+     */
+    pw_stream_destroy(udata->stream);
+    pw_log_info("%s: node destroyed", udata->jack_name);
+    return 0;
+}
