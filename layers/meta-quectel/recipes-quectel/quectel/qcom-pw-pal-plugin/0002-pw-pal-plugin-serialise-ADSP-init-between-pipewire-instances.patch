         calloc(1, sizeof(pal_param_device_connection_t));
     device_connection->connection_state = state;
     device_connection->id = udata->pal_device_id;
@@ -834,16 +990,12 @@ int pipewire__module_init(struct pw_impl_module *module, const char *args)
 
     udata->module = module;
     udata->context = context;
-    res = agm_init();
-    if (res) {
-        pw_log_error("%s: agm init failed\n", __func__);
-        goto error;
-    }
-    res = pal_init();
-    if (res) {
-        pw_log_error("%s: pal init failed\n", __func__);
-        goto error;
-    }
+    /*
+     * No audio initialisation here: it is deferred to the first stream (see
+     * pw_pal_init_audio()). Loading the six module instances and creating their
+     * nodes needs no ADSP, so pipewire comes up immediately whichever instance
+     * already owns it.
+     */
     if (pw_properties_get(props, PW_KEY_NODE_VIRTUAL) == NULL)
         pw_properties_set(props, PW_KEY_NODE_VIRTUAL, "true");
 
