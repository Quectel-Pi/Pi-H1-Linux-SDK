[Unit]
Description=Fan LED Control by CPU Temperature
After=local-fs.target
# persist 是独立分区(/dev/disk/by-partlabel/persist)，flag 落在里面。
# 只做顺序依赖(不用 Requires)，挂载失败时仍然能按 condition 判定，不会被拖着起不来。
After=var-persist.mount pi-cleanup.service
# 产线 AT 测试模式(/var/persist/fct_done_flag 不存在)下不启动温控：此时风扇由
# AT+FANON / AT+FANOFF 独占控制，避免这里每 5s 按温度把 pwm1 覆盖回去。
# AT+QFCT="done" 建好 flag 后会显式 systemctl start 把温控接回来。
ConditionPathExists=/var/persist/fct_done_flag
Before=shutdown.target poweroff.target halt.target reboot.target

[Service]
Type=simple
ExecStart=/bin/bash -c "while true; do /usr/sbin/fan_ctrl.sh; sleep 5; done"
ExecStop=/bin/bash -c "echo '[FAN] ExecStop start' > /dev/kmsg; HWMON_DIR=''; for d in /sys/class/hwmon/hwmon*; do if [ -f \"$d/name\" ] && [ \"$(cat \"$d/name\" 2>/dev/null)\" = \"pwmfan\" ]; then HWMON_DIR=\"$d\"; break; fi; done; if [ -n \"$HWMON_DIR\" ]; then [ -w \"$HWMON_DIR/pwm1_enable\" ] && echo 0 > \"$HWMON_DIR/pwm1_enable\" || true; [ -w \"$HWMON_DIR/pwm1\" ] && echo 0 > \"$HWMON_DIR/pwm1\" || true; fi; logger -t fan_ctrl 'Fan stopped by ExecStop' || true; echo '[FAN] ExecStop done' > /dev/kmsg"
RemainAfterExit=yes
KillMode=process
TimeoutStopSec=3

Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target