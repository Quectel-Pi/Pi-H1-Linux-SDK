[Desktop Entry]
Type=Application
Name=Pi Agent (first run)
Name[zh_CN]=Pi Agent（首次运行）
Comment=Install and configure the Pi Agent
Comment[zh_CN]=安装并配置 Pi Agent
Exec=/usr/bin/pi-agent --only-if-needed
Icon=pi-agent
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
# Autostart only starts the wizard when it still has something to ask: pi not
# installed, or installed but never configured. The check is in the program
# (--only-if-needed), not here, because a .desktop file cannot look at
# ~/.pi/agent/state. A "later" or "never" answer is recorded there too, so the
# window does not reappear on the next login.
X-GNOME-Autostart-Phase=Applications
X-GNOME-Autostart-Delay=8
