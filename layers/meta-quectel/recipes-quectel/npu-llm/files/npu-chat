    def fire(self, text):
        self.entry.set_text(text)
        self.send()

    def send(self, *_):
        text = self.entry.get_text().strip()
        if self.model is None:
            return
        if getattr(self, "busy", False):
            return
        image = self.image
        if image is not None and not image_capable(self.model):
            self.drop_attach()
            self.status.set_text(f"{self.model} 不支持识图，已移除图片")
            image = None
        if not text and image is None:
            return
        if getattr(self, "welcome", None) is not None:
            self.list.remove(self.welcome)
            self.welcome = None

        if not text:  # a bare picture: let the model describe it
            text = DEFAULT_IMAGE_PROMPT
        self.entry.set_text("")
        self.drop_attach()
        self.busy = True
        self.job = {"p": None, "stop": False}
        self.speech_pos = 0
        self.hush()
        self.send_btn.set_sensitive(False)
        self.stop_btn.set_sensitive(True)
        self.chip.add_css_class("busy")
        if image is None:
            self.bubble(text, True)
        else:
            self.bubble(text, True,
                        meta="识图 · 图像 %.0f KB" % (len(image["data"]) / 1024.0),
                        image=image)
        self.history.append(("user", text))

        card = Gtk.Box()
        card.add_css_class("card-bot")
        body = Gtk.Label(label="●", xalign=0, yalign=0)
        body.add_css_class("typing")
        card.append(body)
        holder = Gtk.Box()
        holder.append(card)
        holder.set_halign(Gtk.Align.START)
        self.list.append(holder)
        self.glide()

        phase = {"i": 0, "t0": time.monotonic(), "got": 0, "first": 0.0}
        anim = {"target": "", "shown": 0, "live": True}

        def show(txt):
            if not phase["got"]:
                # first chunk: the dots become the answer
                body.remove_css_class("typing")
                body.add_css_class("bub-bot")
                body.set_wrap(True)
                body.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
                body.set_max_width_chars(62)
                body.set_selectable(True)
                phase["first"] = time.monotonic() - phase["t0"]
            phase["got"] = len(txt)
            # The engine hands out multi-character tokens roughly every 0.19 s.
            # Slam them in whole and the bubble jumps by a word at a time, so the
            # text is revealed a character at a time instead: lagging the stream
            # by at most a couple of tokens, which is what makes it read like it
            # is being typed rather than pasted.
            anim["target"] = txt
            self.feed_speech(txt)
            return False

        def pump():
            target = anim["target"]
            lag = len(target) - anim["shown"]
            if lag > 0:
                anim["shown"] += 1 if lag < 24 else (2 if lag < 60 else 4)
                if anim["shown"] > len(target):
                    anim["shown"] = len(target)
                body.set_text(target[: anim["shown"]])
                self.glide()
            elif not anim["live"]:
                return False
            return True

        def tick():
            if not self.busy:
                return False
            el = max(time.monotonic() - phase["t0"], 0.001)
            if phase["got"]:
                self.status.set_text(
                    f"{self.model}  首字 {phase['first']:0.1f}s  生成 {el:0.1f}s"
                    f"  约 {tokens(anim['target']) / el:0.1f} tok/s"
                )
            else:
                body.set_text(["●", "●●", "●●●"][phase["i"] % 3])
                self.status.set_text(f"{self.model} 正在 NPU 上生成…  {el:0.1f}s")
            phase["i"] += 1
            return True

        timer = GLib.timeout_add(250, tick)
        GLib.timeout_add(40, pump)

        def work():
            prompt = build_prompt(self.model, self.history)
            txt, err, dt, stopped, meta = ask(
                self.model, prompt, on_chunk=lambda t: GLib.idle_add(show, t), job=self.job,
                history=self.history, image=image,
            )
            GLib.idle_add(done, txt, err, dt, stopped, meta)

        def done(txt, err, dt, stopped, meta=None):
            GLib.source_remove(timer)
            # stop accepting new targets, but let the reveal animation drain
            anim["live"] = False
            self.busy = False
            self.send_btn.set_sensitive(True)
            self.stop_btn.set_sensitive(False)
            self.chip.remove_css_class("busy")
            if err:
                self.list.remove(holder)
                self.error(f"推理失败：{err}")
                self.status.set_text("失败")
                return False
            if not txt:
                self.list.remove(holder)
                self.status.set_text("已停止")
                return False
            show(txt)
            if getattr(self, "shot", False) and self.ask_text:
                # a screenshot is taken of a finished answer, not a half-revealed
                # one
                anim["shown"] = len(txt)
            self.history.append(("assistant", txt))
            tail = txt[self.speech_pos :].strip()
            if tail and self.speak_btn.get_active() and voice_ready():
                if self.speaker is None:
                    self.speaker = Speaker()
                self.speaker.say(tail)
                self.speech_pos = len(txt)
            approx = tokens(txt) / dt if dt > 0 else 0
            tag = "已停止" if stopped else f"{dt:0.1f}s"
            seen = (meta or {}).get("vision_run_seconds") or 0
            self.status.set_text(
                f"{self.model}  ·  首字 {phase['first']:0.1f}s  ·  {tag}"
                f"  ·  约 {approx:0.1f} tok/s"
                + (f"  ·  识图 {seen:0.1f}s" if seen else "")
            )
            if self.ask_text:
                print(f"ANSWER ({dt:0.1f}s): {txt}\nSTATUS: {self.status.get_text()}")
                if self.shot:
                    GLib.timeout_add(1800, self.take_shot)
                else:
                    self.quit()
            else:
                GLib.timeout_add(200, self.next_turn)
            return False

        threading.Thread(target=work, daemon=True).start()


def selftest():
    q = build_prompt("qwen2.5-0.5b", [("user", "hi"), ("assistant", "yo"), ("user", "ok")])
    assert q.endswith("<|im_start|>assistant\n"), q
    assert "<|im_start|>user\nhi<|im_end|>" in q
    l = build_prompt("llama3.2-1b", [("user", "hi")])
    assert l.startswith("<|start_header_id|>user<|end_header_id|>\n\nhi<|eot_id|>"), l
    assert l.endswith("<|start_header_id|>assistant<|end_header_id|>\n\n"), l
    # trimming keeps the newest turn and stays under budget
    long_hist = [("user", "x" * 1000), ("assistant", "y" * 1000), ("user", "last")]
    t = build_prompt("qwen2.5-0.5b", long_hist)
    assert "last" in t and len(t) < 1900, len(t)
    assert extract("junk\n[BEGIN]: hello\nworld[END]\nnoise rpcmem\n") == ("hello\nworld", None)
    # streaming: the buffer is re-extracted while generation is still running, so
    # a missing [END] must still yield the text received so far
    assert extract("banner\n[BEGIN]: 大海是")[0] == "大海是"
    assert extract("noise only")[0] is None
    # server path: roles must survive the history->messages mapping, and the
    # user turn that arrived last must be the last message sent
    b = chat_body([("user", "hi"), ("assistant", "yo"), ("user", "ok")], "m")
    assert [m["role"] for m in b["messages"]] == ["user", "assistant", "user"], b
    assert b["messages"][-1]["content"] == "ok" and b["stream"] is True and b["model"] == "m"
    # 识图: one inline data URL on the last turn only, picture before question
    img = {"data": b"\xff\xd8junk", "mime": "image/jpeg", "name": "x.jpg"}
    bi = chat_body([("user", "hi"), ("user", "看图")], "m", img)
    last = bi["messages"][-1]
    assert last["role"] == "user" and isinstance(last["content"], list), last
    assert last["content"][0]["type"] == "image_url", last
    assert last["content"][0]["image_url"]["url"].startswith("data:image/jpeg;base64,"), last
    assert last["content"][1] == {"type": "text", "text": "看图"}, last
    assert all(isinstance(m["content"], str) for m in bi["messages"][:-1]), bi
    # an empty question with a picture still sends the picture
    bn = chat_body([("user", "")], "m", img)
    assert bn["messages"][-1]["content"][0]["type"] == "image_url", bn
    assert len(bn["messages"][-1]["content"]) == 1, bn
    # 识图 is gated on the vision model
    assert image_capable(QWEN35_MODEL) == bool(QWEN35_VISION)
    assert not image_capable("qwen2.5-0.5b") and not image_capable("llama3.2-1b")
    # suffix → mime table drives both the picker and load_image()
    assert IMAGE_SUFFIX_MIME[".jpg"] == IMAGE_SUFFIX_MIME[".JPEG".lower()] == "image/jpeg"
    try:
        load_image("/tmp/npu-chat-nope.gif")
        raise AssertionError("gif must be refused")
    except (ValueError, OSError):
        pass
    # a black frame must be recognised as dark: that is the warm-up guard
    assert mean_luma(b"\0" * 9000) == 0.0 and mean_luma(b"\xff" * 9000) > 200
    if GdkPixbuf is not None:
        rgb = bytes([200, 40, 40]) * (8 * 8)
        jpg = jpeg_from_rgb(rgb, 8, 8)
        assert jpg[:2] == b"\xff\xd8" and len(jpg) > 100, jpg[:4]
        assert texture_for({"data": jpg}) is not None
    t, e = extract("some error: boom")
    assert t is None and "error" in e, (t, e)
    assert abs(tokens("hello world") - 2.75) < 0.01, tokens("hello world")
    assert abs(tokens("秋天") - 2) < 0.01, tokens("秋天")

    # voice: finished sentences leave the buffer, the tail stays for the next
    # chunk, and decimals are not mistaken for sentence ends
    assert new_sentences("今天晴。气温二十度", 0) == (["今天晴。"], 4)
    assert new_sentences("今天晴。气温二十度。", 4) == (["气温二十度。"], 10)
    assert new_sentences("你好", 0) == ([], 0)
    assert new_sentences("pi is 3.14 ok. done", 0) == (["pi is 3.14 ok."], 14)
    assert new_sentences("雨。", 0)[0] == ["雨。"]
    assert cn_number("0") == "零"
    assert cn_number("12") == "十二"
    assert cn_number("105") == "一百零五"
    assert cn_number("2024") == "二千零二十四"
    assert cn_number("123456") == "一二三四五六"
    if voice_ready():
        if tts_engine() == "vits":
            assert speakable("他买了10个面包。") == "他买了十个面包。"
            assert speakable("3+2=5") == "三加二等于五"
            assert speakable("温度25℃") == "温度二十五"
            assert speakable("湿度60%") == "湿度百分之六十"
            assert speakable("%") == "百分之"
        else:
            # digits are only spelled out where they land in Chinese text
            assert speakable("他买了10个面包。") == "他买了十个面包。"
            assert speakable("温度是25度，湿度60%。") == "温度是二十五度，湿度百分之六十。"
            assert speakable("It boots in 12 seconds.") == "It boots in 12 seconds."
            assert speakable("The GPU runs at 587 MHz.") == "The GPU runs at 587 MHz."
            assert speakable("湿度60% and 60% humidity") == "湿度百分之六十 and 60% humidity"
            assert speakable("好的👍，明白了。") == "好的，明白了。"
            assert speakable("good👍job") == "good job"
            assert speakable("3+2=5") == "3+2=5"
        assert speakable("<|endoftext|>") == ""
    # hands-free VAD: read the tail of a wav that is still being written
    p = os.path.join(tempfile.gettempdir(), "npu-chat-rms.wav")
    with open(p, "wb") as f:
        f.write(b"\0" * 44)
        f.write(array.array("h", [0] * 1600 + [1000] * 1600).tobytes())
    assert 600 < tail_rms(p) < 800, tail_rms(p)
    assert tail_rms("/dev/null") is None
    os.unlink(p)
    # every engine that can be on disk has a level, and the ceiling leaves
    # headroom for the amp that was tuned on the older, quieter voice
    assert set(TTS_GAIN) == {"matcha", "vits"}, TTS_GAIN
    assert all(0.0 < g <= 1.0 for g in TTS_GAIN.values()), TTS_GAIN
    assert 0.0 < TTS_PEAK < 1.0, TTS_PEAK
    print("selftest ok")


def voice_selftest(seconds=4):
    """End-to-end check without the GUI: record, transcribe, then speak."""
    if not voice_ready():
        print(f"voice payload missing under {VOICE}")
        return 1
    print("recorder:", recorder(), "player:", player())
    r = Recorder("/tmp/npu-chat-selftest.wav")
    r.start()
    print(f"recording {seconds}s — say something now")
    time.sleep(seconds)
    path = r.stop()
    t0 = time.monotonic()
    text = transcribe(path)
    print(f"ASR {time.monotonic() - t0:0.2f}s: {text!r}")
    out = "/tmp/npu-chat-selftest-tts.wav"
    t0 = time.monotonic()
    secs = synth("语音链路正常。", out)
    dt = time.monotonic() - t0
    print(f"TTS {dt:0.2f}s for {secs:0.2f}s audio ({secs / dt:0.2f}x real time)")
    cmd = player()
    if cmd:
        t0 = time.monotonic()
        subprocess.run(cmd + [out], check=False)
        print(f"played in {time.monotonic() - t0:0.2f}s")
    return 0


if __name__ == "__main__":
    if "--selftest" in sys.argv:
        selftest()
        sys.exit(0)
    if "--voice-selftest" in sys.argv:
        i = sys.argv.index("--voice-selftest")
        try:
            sys.exit(voice_selftest(int(sys.argv[i + 1])))
        except (IndexError, ValueError):
            sys.exit(voice_selftest())
    shot = None
    if "--shot" in sys.argv:
        shot = sys.argv[sys.argv.index("--shot") + 1]
    ask_image = None
    if "--image" in sys.argv:
        ask_image = sys.argv[sys.argv.index("--image") + 1]
    ask_text = None
    if "--ask" in sys.argv:
        ask_text = sys.argv[sys.argv.index("--ask") + 1]
    if "--model" in sys.argv:
        want = sys.argv[sys.argv.index("--model") + 1]
    else:
        want = None
    app = Chat(application_id="org.quectel.NpuChat")
    app.shot = shot
    app.ask_text = ask_text
    app.ask_image = ask_image
    app.want_model = want
    app.run([])
