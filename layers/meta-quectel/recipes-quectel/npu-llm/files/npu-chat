    def shoot(self, pop=None):
        """One frame from the CamxBridge node, off the main loop."""
        if pop is not None:
            pop.popdown()
        if not image_capable(self.model):
            self.status.set_text(f"只有 {QWEN35_MODEL} 支持识图")
            return
        self.status.set_text(f"正在从 {CAM_DEVICE} 拍照…")

        def run():
            try:
                data = camera_jpeg()
                image = {"data": data, "mime": "image/jpeg",
                         "name": "摄像头 %dx%d" % (CAM_W, CAM_H)}
                err = None
            except Exception as e:  # pipeline missing, node busy, encoder
                image, err = None, f"{type(e).__name__}: {e}"
            GLib.idle_add(self._shoot_done, image, err)

        threading.Thread(target=run, daemon=True).start()

    def _shoot_done(self, image, err):
        if err:
            self.status.set_text(f"拍照失败：{err}")
            return False
        self.set_attach(image)
        return False

    def set_attach(self, image):
        texture = texture_for(image, (112, 63))
        if texture is not None:
            self.attach_pic.set_paintable(texture)
        self.image = image
        kb = len(image["data"]) / 1024.0
        self.attach_name.set_text(image.get("name") or "图片")
        self.attach_hint.set_text(
            "%.0f KB · 发送时一起提交给 %s，首字会慢一些" % (kb, QWEN35_MODEL))
        self.attach_bar.set_visible(True)
        self.status.set_text("图片已就绪，可以输入问题（留空则让它描述这张图）")

    def drop_attach(self):
        self.image = None
        self.attach_pic.set_paintable(None)
        self.attach_bar.set_visible(False)

    def pick(self, name, pop):
        if self.model == QWEN35_MODEL != name:
            # The resident engine holds ~3 GB of NPU context; a genie model
            # needs most of the rest, so free it before handing over.
            subprocess.run(["systemctl", "stop", "qwen35"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.model = name
        self.chip.set_label(name)
        self.sync_image_button()
        if self.image is not None and not image_capable(name):
            # the picture would be rejected by a text model anyway
            self.drop_attach()
        pop.popdown()
        self.status.set_text(f"已切换到 {name}")

    def stop(self, *_):
        """Cut the turn short. SIGINT first; genie usually exits in ~0.1 s and the
        DSP is free for the next turn, SIGKILL is only a backstop."""
        p = getattr(self, "job", {}).get("p")
        self.hush()
        if p is None or p.poll() is not None:
            if self.busy:  # server model: no child, flag the reader loop
                self.job["stop"] = True
                self.status.set_text("正在停止…")
                return
            self.status.set_text("已停止朗读")
            return
        self.job["stop"] = True
        p.send_signal(signal.SIGINT)

        def backstop():
            if p.poll() is None:
                p.kill()
            return False

        GLib.timeout_add(2000, backstop)
        self.status.set_text("正在停止…")

    def clear(self, *_):
        if getattr(self, "busy", False):
            return
        self.hush()
        while self.list.get_first_child() is not None:
            self.list.remove(self.list.get_first_child())
        self.history = []
        self.welcome = None
        self.drop_attach()
        self.show_welcome()
        self.status.set_text("已清空")

