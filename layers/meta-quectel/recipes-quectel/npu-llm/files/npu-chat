def qwen35_up(timeout=0.4):
    try:
        with urllib.request.urlopen(QWEN35_URL + "/v1/models", timeout=timeout):
            return True
    except OSError:
        return False


def qwen35_installed():
    """True when qwen3.5 can take the default slot.

    The server is deliberately NOT enabled at boot: it pins four big cores,
    holds ~490 MB RSS and owns the whole NPU context, so it is started here --
    on the first turn after the user selects qwen3.5 -- and stopped again when
    the user switches to another model (see pick()). Availability therefore
    depends on the install being complete (launcher + every asset), never on the
    unit being enabled or on a satisfied marker: start_qwen35() waits for the
    server either way.
    """
    if os.environ.get("QWEN35_HIDE") == "1":
        return False
    if os.environ.get("QWEN35_FORCE") == "1":
        return _qwen35_artifacts()
    return _qwen35_present()


def _qwen35_artifacts():
    have = lambda f: os.path.exists(os.path.join(QWEN35_DIR, f))
    return all(have(f) for f in QWEN35_REQUIRED)


def _qwen35_present():
    # The runtime package ships the launcher, the model package ships the
    # assets; both are needed, and the assets are the real gate: without them
    # the unit refuses to start (ConditionPathExists) and offering the model
    # would only produce a start failure on turn one.
    launcher = (os.path.exists(QWEN35_LAUNCH)
                or os.path.exists(QWEN35_NPU_LAUNCH))
    if not launcher:
        return False
    return _qwen35_artifacts()


def start_qwen35():
    """Bring the NPU server up if it is not already running. Returns error text."""
    if qwen35_up():
        return None
    if not _qwen35_artifacts():
        return ("qwen3.5 的模型文件不全（在 %s 下需要 %s）。\n"
                "模型由 qwen35-npu-model 包安装，检查 /usr/share/qwen35 是否"
                "完整，重装该包后 systemctl restart qwen35。"
                % (QWEN35_DIR, " / ".join(QWEN35_REQUIRED)))
    # The engine needs root: /dev/fastrpc-cdsp is root:system and it pins cores
    # 4-7. The unit owns it and the GUI just asks systemd; direct launch stays as
    # the fallback for a manual install the current user can read.
    if shutil.which("systemctl"):
        subprocess.run(["systemctl", "start", "qwen35"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        for launcher in (QWEN35_LAUNCH, QWEN35_NPU_LAUNCH):
            if os.access(launcher, os.X_OK):
                subprocess.Popen([launcher], stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL,
                                 start_new_session=True)
                break
    # Resident by design: a reload per turn would cost several seconds of NPU
    # upload on top of the ~6 s cold start.
    for _ in range(90):
        if qwen35_up(1.0):
            return None
        time.sleep(1)
    return "qwen3.5 未启动，试 systemctl start qwen35 或看 journalctl -u qwen35"


def trim_history(history, budget=None):
    """Newest turns that fit in the prompt budget, starting on a user turn."""
    budget = QWEN35_HISTORY_TOKENS if budget is None else budget
    kept, total = [], 0.0
    for role, text in reversed(history):
        cost = tokens(text)
        if kept and total + cost > budget:
            break
        kept.append((role, text))
        total += cost
    kept.reverse()
    while len(kept) > 1 and kept[0][0] != "user":
        kept.pop(0)
    return kept


def image_capable(model):
    """识图 is a qwen3.5-only feature: the genie models have no vision tower."""
    return model == QWEN35_MODEL and QWEN35_VISION


def image_data_url(image):
    return "data:%s;base64,%s" % (
        image["mime"], base64.b64encode(image["data"]).decode("ascii"))


def load_image(path):
    """Read a still image off disk and check it against the server's limits."""
    mime = IMAGE_SUFFIX_MIME.get(os.path.splitext(path)[1].lower())
    if mime is None:
        raise ValueError("只支持 PNG / JPEG / WebP 图片")
    with open(path, "rb") as f:
        data = f.read()
    if not data:
        raise ValueError("图片是空文件")
    if len(data) > IMAGE_MAX_BYTES:
        raise ValueError("图片太大（%.1f MB，上限 %.0f MB）"
                         % (len(data) / 1e6, IMAGE_MAX_BYTES / 1e6))
    return {"data": data, "mime": mime, "name": os.path.basename(path)}


def mean_luma(raw, step=997):
    """Rough average brightness of an RGB frame (0-255), sampled."""
    if not raw:
        return 0.0
    total = n = 0
    for i in range(0, len(raw), step):
        total += raw[i]
        n += 1
    return total / n if n else 0.0


def jpeg_from_rgb(raw, width, height, quality=90):
    """Encode one raw RGB frame as JPEG: the server takes data URLs only."""
    if GdkPixbuf is None:
        raise RuntimeError("缺少 GdkPixbuf，无法编码摄像头画面")
    pixbuf = GdkPixbuf.Pixbuf.new_from_bytes(
        GLib.Bytes.new(bytes(raw)), GdkPixbuf.Colorspace.RGB, False, 8,
        width, height, width * 3)
    ok, buf = pixbuf.save_to_bufferv("jpeg", ["quality"], [str(int(quality))])
    if not ok or not buf:
        raise RuntimeError("JPEG 编码失败")
    return bytes(buf)


def camera_jpeg(device=CAM_DEVICE, width=CAM_W, height=CAM_H,
                frames=CAM_FRAMES, luma_min=CAM_LUMA_MIN):
    """Grab one frame off the CamxBridge node and return it as JPEG bytes.

    The node is a v4l2loopback device fed by camx-v4l2-bridge@0, so the raw mode
    is known in advance and the frames can be read as plain RGB.  Reading more
    than one frame is required rather than defensive: the frames right after the
    bridge (re)builds the stream are black, and a black frame is a useless
    request -- the model can only answer that the picture is black.
    """
    nbytes = width * height * 3
    cmd = ["gst-launch-1.0", "-q", "v4l2src", "device=" + device, "!",
           "videoconvert", "!",
           "video/x-raw,format=RGB,width=%d,height=%d" % (width, height),
           "!", "fdsink", "fd=1", "sync=false"]
    if not shutil.which("gst-launch-1.0"):
        raise RuntimeError("缺少 gst-launch-1.0，无法取摄像头画面")
    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, bufsize=nbytes * 2)
    except OSError as e:
        raise RuntimeError("启动取流失败：%s" % e) from e
    best, good = None, 0
    try:
        fd = proc.stdout.fileno()
        for _ in range(max(1, frames)):
            frame = read_frame(fd, nbytes)
            if frame is None:
                break
            if mean_luma(frame) >= luma_min:
                best = frame
                good += 1
                if good >= CAM_GOOD:
                    break
    finally:
        proc.kill()
        proc.wait()
    if best is None:
        raise RuntimeError(
            "%s 没有出图（CamxBridge 可能还没建流）。稍等再拍，"
            "或 systemctl restart camx-v4l2-bridge@0" % device)
    return jpeg_from_rgb(best, width, height)


def read_frame(fd, nbytes):
    """Read exactly one frame off a pipe; None on EOF/short read."""
    buf = bytearray(nbytes)
    view = memoryview(buf)
    got = 0
    while got < nbytes:
        n = os.readv(fd, [view[got:]])
        if not n:
            return None
        got += n
    return bytes(buf)


def texture_for(image, box=None):
    """Decode image bytes into a Gdk texture for the thumbnail/preview.

    box=(w, h) scales the picture down to fit that box.  Without it a 1280x720
    capture reports its own natural size and the bubble grows to the full card
    width instead of showing a preview.
    """
    if GdkPixbuf is None or not image:
        return None
    try:
        loader = GdkPixbuf.PixbufLoader()
        loader.write(image["data"])
        loader.close()
        pixbuf = loader.get_pixbuf()
    except (GLib.Error, TypeError):
        return None
    if pixbuf is None:
        return None
    if box:
        bw, bh = box
        sw, sh = pixbuf.get_width(), pixbuf.get_height()
        if sw > bw or sh > bh:
            scale = min(bw / float(sw), bh / float(sh))
            pixbuf = pixbuf.scale_simple(max(1, int(sw * scale)),
                                         max(1, int(sh * scale)),
                                         GdkPixbuf.InterpType.BILINEAR)
    return Gdk.Texture.new_for_pixbuf(pixbuf)


def chat_body(history, model, image=None):
    messages = [{"role": r, "content": t} for r, t in trim_history(history)]
    if image is not None:
        # The server takes one inline image per request and expects the turn that
        # carries it to be the last one, with the picture before the question.
        parts = [{"type": "image_url",
                  "image_url": {"url": image_data_url(image)}}]
        if messages and messages[-1]["content"]:
            parts.append({"type": "text", "text": messages[-1]["content"]})
        messages = messages[:-1] + [{"role": "user", "content": parts}]
    return {"model": model, "max_tokens": QWEN35_MAX_TOKENS, "stream": True,
            "messages": messages}


def ask_server(history, on_chunk=None, job=None, image=None):
    """One turn against the resident Qwen3.5 server, streaming SSE deltas.

    The server keeps the KV/DeltaNet state itself, so the whole history goes out
    every turn and it does its own 2048-token truncation.  An attached image is
    only sent on the turn it was picked for: replaying it on every later turn
    would add ~650 prompt tokens (≈9 s of prefill) for no new information, and
    the answer that described it is already part of the history.
    """
    t0 = time.monotonic()
    meta = None
    err = start_qwen35()
    if err:
        return "", err, time.monotonic() - t0, False, meta
    try:
        with urllib.request.urlopen(QWEN35_URL + "/v1/models", timeout=10) as r:
            mid = json.load(r)["data"][0]["id"]
        req = urllib.request.Request(
            QWEN35_URL + "/v1/chat/completions",
            data=json.dumps(chat_body(history, mid, image),
                            ensure_ascii=False).encode(),
            headers={"Content-Type": "application/json"},
        )
        text = ""
        with urllib.request.urlopen(req, timeout=900) as resp:
            for raw in resp:
                if job and job.get("stop"):
                    break
                if not raw.startswith(b"data:"):
                    continue
                val = raw[5:].strip()
                if val == b"[DONE]":
                    break
                chunk = json.loads(val)
                if chunk.get("error"):
                    raise RuntimeError(chunk["error"])
                if chunk.get("qwen35_metrics"):
                    meta = chunk["qwen35_metrics"]
                for choice in chunk.get("choices", []):
                    piece = choice.get("delta", {}).get("content") or ""
                    if piece:
                        text += piece
                        if on_chunk:
                            on_chunk(text)
    except Exception as e:  # network, JSON, or the server refusing the graph
        return "", f"{type(e).__name__}: {e}", time.monotonic() - t0, False, meta
    return text, None, time.monotonic() - t0, bool(job and job.get("stop")), meta


def tokens(text):
    """Rough token count: CJK is ~1 token per char, latin ~4 chars per token."""
    cjk = sum(1 for ch in text if ord(ch) > 0x2E7F)
    return cjk + (len(text) - cjk) / 4.0


def ask(model, prompt, on_chunk=None, job=None, history=None, image=None):
    """Run one turn, streaming. Returns (text, error, seconds, stopped, meta).

    on_chunk(text) is called from this thread with the answer so far, so the
    caller must marshal to the main loop. job is a dict the caller can use to
    cancel: job["p"] holds the child, job["stop"] says a stop was asked for.
    image is an attached picture (dict with data/mime) for the vision model.
    """
    if model == QWEN35_MODEL:
        return ask_server(history or [("user", prompt)], on_chunk, job, image)
    if image is not None:
        return "", f"{model} 不支持识图，只有 {QWEN35_MODEL} 能看图", 0.0, False, None
    d = os.path.join(DATA, model)
    env = dict(os.environ)
    env["LD_LIBRARY_PATH"] = ROOT + (":" + env["LD_LIBRARY_PATH"] if env.get("LD_LIBRARY_PATH") else "")
    env["ADSP_LIBRARY_PATH"] = ROOT + (":" + env["ADSP_LIBRARY_PATH"] if env.get("ADSP_LIBRARY_PATH") else "")
    t0 = time.monotonic()
    p = subprocess.Popen(
        ["stdbuf", "-o0", "-e0", os.path.join(ROOT, "genie-t2t-run"), "-c", "model-config.json",
         "-p", prompt],
        cwd=d, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, bufsize=0,
        preexec_fn=_die_with_parent,
    )
    if job is not None:
        job["p"] = p
    raw = bytearray()
    text = ""
    try:
        while True:
            chunk = p.stdout.read(4096)
            if not chunk:
                break
            raw += chunk
            # Re-extract from everything so far: extract() already knows how to
            # skip the rpcmem banner and stop at [END], and on a truncated
            # buffer it just returns the text without the closing marker.
            sofar, _ = extract(raw.decode("utf-8", "replace"))
            if sofar and sofar != text:
                text = sofar
                if on_chunk:
                    on_chunk(text)
    finally:
        p.wait()
        if job is not None:
            job["p"] = None
    dt = time.monotonic() - t0
    stopped = bool(job and job.get("stop"))
    if text:
        return text, None, dt, stopped, None
    _, err = extract(raw.decode("utf-8", "replace"))
    if stopped:
        return "", None, dt, True, None
    return "", err or f"genie-t2t-run exited {p.returncode}", dt, False, None


try:
    _PRCTL = ctypes.CDLL("libc.so.6", use_errno=True).prctl
except (OSError, AttributeError):
    _PRCTL = None


def _die_with_parent():
    """Kill the model process if the GUI dies; an orphaned genie holds the DSP
    and the next run fails with 'Failed to create device: 14001' until reboot.
    Runs in the forked child, so libc is loaded above, not here."""
    if _PRCTL:
        try:
            _PRCTL(1, signal.SIGKILL)  # PR_SET_PDEATHSIG
        except Exception:
            pass


# ---------------------------------------------------------------------- voice
# Offline ASR + TTS, nothing leaves the board: sherpa-onnx with SenseVoice small
# for speech in and Matcha-TTS for speech out, both on the CPU while the LLM
# keeps the DSP. Measured on this board: ASR ~17x real time (0.3 s for 5.6 s of
# audio), TTS ~10x real time at 4 threads (0.33 s for a 4 s mixed sentence)
# with 248-258 MB RSS. Capture and playback use PipeWire (pw-record/pw-play)
# and fall back to ALSA (arecord/aplay).
VOICE = os.environ.get("NPU_LLM_VOICE", "/usr/share/npu-llm/voice")
SHERPA = os.environ.get("NPU_LLM_SHERPA", "/usr/lib/npu-llm/voice")
ASR_FILES = ("model.int8.onnx", "tokens.txt")
# Speech out is a Matcha-TTS acoustic model plus the 16 kHz universal vocoder it
# insists on. It is one female voice for both Chinese and English, which is the
# whole point: the VITS it replaces (vits-zh-hf-fanchen-C) uses a character
# lexicon with no Latin entry in it, so every English word was logged as OOV
# and dropped -- English answers were read as 0.1 s of near-silence. Both
# layouts are understood here so an image with the old payload still speaks;
# the recipe ships the Matcha one.
TTS_MATCHA = ("model-steps-3.onnx", "vocos-16khz-univ.onnx", "lexicon.txt", "tokens.txt")
TTS_VITS = ("model.onnx", "lexicon.txt", "tokens.txt")
# espeak-ng is what phonemises the Latin half of the Matcha model. Debian keeps
# its data in an arch-triplet directory, OE in /usr/lib; a copy under tts/ wins
# if one is shipped there.
ESPEAK_DATA = (
    os.path.join(VOICE, "tts", "espeak-ng-data"),
    "/usr/lib/aarch64-linux-gnu/espeak-ng-data",
    "/usr/lib/espeak-ng-data",
    "/usr/share/espeak-ng-data",
)
ENDERS = "。！？!?；;\n"
# hands-free listening: speech must cross SPEECH_RMS before trailing silence can
# end the utterance. Measured on this board: ambient ~40, normal speech ~400.
SPEECH_RMS = 150
SILENCE_S = 0.8
# Speaking rate. Both voices are natural at 1.0 and start to sound rushed past
# 1.5; NPU_LLM_TTS_SPEED overrides it (0.9 for dictation, 1.4 for speed). None
# means "whatever the installed engine likes", see synth().
TTS_SPEED = (
    float(os.environ["NPU_LLM_TTS_SPEED"])
    if os.environ.get("NPU_LLM_TTS_SPEED")
    else None
)
# The two engines do not come out at the same level: measured on the same two
# sentences, fanchen peaks at 0.34 with 0.045 rms, Matcha at 0.66 with 0.145
# rms, i.e. about 10 dB hotter. The codec/amp on this board is set for the
# quieter one, and Matcha at 0.32 still came out harsh by ear, so the default
# sits lower again. NPU_LLM_TTS_GAIN overrides it (0.2 is audibly louder than
# this, 0.12 is whisper level).
TTS_GAIN = {"matcha": 0.16, "vits": 1.0}
# Peak ceiling after the gain: the amp still clips on a sentence that lands at
# full scale, so anything above this is scaled down rather than clipped.
TTS_PEAK = 0.85

_sx = None
_asr = None
_tts = None
_chars = None
_lock = threading.Lock()
_gen = threading.Lock()

DIGITS = "零一二三四五六七八九"
UNITS = ("", "十", "百", "千")
SAY_MAP = {"+": "加", "=": "等于", "×": "乘", "÷": "除以", "&": "和"}


def cn_number(s):
    """'12' -> 十二, '105' -> 一百零五; digit by digit past four places so
    years and long ids stay recognisable."""
    s = s.lstrip("0") or "0"
    if s == "0":
        return "零"
    if len(s) > 4:
        return "".join(DIGITS[int(c)] for c in s)
    out = []
    for i, ch in enumerate(s):
        v = int(ch)
        if v:
            out.append(DIGITS[v] + UNITS[len(s) - i - 1])
        elif out and out[-1] != "零":
            out.append("零")
    text = "".join(out).rstrip("零")
    return text[1:] if text.startswith("一十") else text


def _is_han(ch):
    o = ord(ch)
    return 0x3400 <= o <= 0x9FFF or 0xF900 <= o <= 0xFAFF


def _zh_around(text, i, j, window=8):
    """True when a Han character sits near text[i:j], i.e. that number belongs
    to a Chinese phrase. Only the neighbourhood counts: "the board boots in
    twelve seconds" has to stay English, while "温度是25度" must not be read by
    the espeak fallback as "温度是twenty five度"."""
    return any(_is_han(c) for c in text[max(0, i - window):i] + text[j:j + window])


# What the Matcha model can pronounce: espeak-ng handles anything ASCII, the
# lexicon handles Han, and both handle CJK punctuation. Everything else -- emoji
# above all -- is not a phoneme and comes back as garbage syllables ("👍" was
# read as "ss stop"), so those characters are dropped.
TTS_ASCII = set(" .,!?;:'\"()-/+=")
TTS_CJK = set("，。！？、；：—…·（）《》“”‘’")


def _speakable_matcha(text):
    """Clean up a sentence for the Chinese+English model.

    Latin words need no help: espeak reads digits, %, acronyms and even I/O
    correctly. What it cannot do is read a number inside a Chinese sentence --
    "温度是12度" came out as "温度是刮呕度", and 3:30 as "three点 fifty分" -- so
    arabic digits are expanded to Chinese characters when Han text is nearby,
    and left alone otherwise. The model itself ships number/date rule fsts, but
    they are Chinese-only and turn "12 seconds" into "十二 seconds", which is
    why they are not loaded.
    """
    # Chat templates leak special tokens into the answer; they are markers, not
    # words, so "<|endoftext|>" must not be read out as "endoftext".
    keep, i = [], 0
    while True:
        a = text.find("<|", i)
        b = text.find("|>", a + 2) if a >= 0 else -1
        keep.append(text[i:a] if a >= 0 else text[i:])
        if b < 0:
            break
        i = b + 2
    text = "".join(keep)

    out, i = [], 0
    while i < len(text):
        ch = text[i]
        if ch.isdigit():
            j = i  # a decimal point belongs to the number: 12.5 is 十二点五
            while j < len(text) and (
                text[j].isdigit()
                or (text[j] == "." and j + 1 < len(text) and text[j + 1].isdigit())
            ):
                j += 1
            run = text[i:j]
            if _zh_around(text, i, j):
                whole, _, frac = run.partition(".")
                if frac:
                    run = cn_number(whole) + "点" + "".join(DIGITS[int(c)] for c in frac)
                else:
                    run = cn_number(whole)
            out.append(run)
            i = j
            continue
        if ch == "%":  # espeak already says "percent", Chinese needs 百分之
            if out and out[-1][-1:] in DIGITS + "十百千" and _zh_around(text, i, i + 1):
                out[-1] = "百分之" + out[-1]
            elif not _zh_around(text, i, i + 1):
                out.append("%")
            i += 1
            continue
        if ch in SAY_MAP:
            out.append(SAY_MAP[ch] if _zh_around(text, i, i + 1) else ch)
        elif _is_han(ch) or ch in TTS_CJK:
            out.append(ch)
        elif ch.isascii() and (ch.isalnum() or ch in TTS_ASCII):
            out.append(ch)
        elif out and out[-1] != " " and (
            (out[-1][-1].isascii() and out[-1][-1].isalnum())
            or (i + 1 < len(text) and text[i + 1].isascii() and text[i + 1].isalnum())
        ):
            # a dropped symbol must not glue two Latin words together, and must
            # not leave a stray space inside Chinese punctuation either
            out.append(" ")
        i += 1
    return "".join(out).strip()


def _speakable_chars():
    """The VITS lexicon has no arabic digits and few symbols: anything outside
    its character set is dropped, digits are read out in Chinese."""
    global _chars
    if _chars is None:
        cs = set("，。！？、；：—…·")
        with open(os.path.join(VOICE, "tts", "lexicon.txt"), encoding="utf-8") as f:
            for line in f:
                if line.strip():
                    cs.add(line.split(" ", 1)[0])
        _chars = cs
    return _chars


def speakable(text):
    if tts_engine() != "vits":
        return _speakable_matcha(text)
    cs = _speakable_chars()
    out, i = [], 0
    while i < len(text):
        ch = text[i]
        if ch.isdigit():
            j = i
            while j < len(text) and text[j].isdigit():
                j += 1
            out.append(cn_number(text[i:j]))
            i = j
            continue
        if ch == "%":  # 60% reads as 百分之六十, so it goes in front of the number
            if out and out[-1] and out[-1][-1] in DIGITS + "十百千":
                out[-1] = "百分之" + out[-1]
            else:
                out.append("百分之")
            i += 1
            continue
        if ch in cs:
            out.append(ch)
        elif ch in SAY_MAP:
            out.append(SAY_MAP[ch])
        i += 1
    return "".join(out)


def tts_engine():
    """'matcha', 'vits' or None, from whatever is actually on disk."""
    tts = os.path.join(VOICE, "tts")
    for name, files in (("matcha", TTS_MATCHA), ("vits", TTS_VITS)):
        if all(os.path.isfile(os.path.join(tts, f)) for f in files):
            return name
    return None


def espeak_data():
    """The espeak-ng data directory the Matcha model phonemises Latin with."""
    for d in ESPEAK_DATA:
        if os.path.isfile(os.path.join(d, "phontab")):
            return d
    return ""


def voice_ready():
    if tts_engine() is None:
        return False
    if tts_engine() == "matcha" and not espeak_data():
        return False
    return all(
        os.path.isfile(os.path.join(VOICE, "asr", f)) for f in ASR_FILES
    )


def _sherpa():
    global _sx
    if _sx is None:
        if SHERPA not in sys.path:
            sys.path.insert(0, SHERPA)
        import sherpa_onnx

        _sx = sherpa_onnx
    return _sx


def speech_engine():
    global _tts
    with _lock:
        if _tts is None:
            sx = _sherpa()
            tts = os.path.join(VOICE, "tts")
            if tts_engine() == "matcha":
                cfg = sx.OfflineTtsModelConfig(
                    matcha=sx.OfflineTtsMatchaModelConfig(
                        acoustic_model=os.path.join(tts, "model-steps-3.onnx"),
                        vocoder=os.path.join(tts, "vocos-16khz-univ.onnx"),
                        lexicon=os.path.join(tts, "lexicon.txt"),
                        tokens=os.path.join(tts, "tokens.txt"),
                        data_dir=espeak_data(),
                    ),
                    num_threads=4,  # 4 is the sweet spot here, 8 is slower
                )
            else:
                cfg = sx.OfflineTtsModelConfig(
                    vits=sx.OfflineTtsVitsModelConfig(
                        model=os.path.join(tts, "model.onnx"),
                        lexicon=os.path.join(tts, "lexicon.txt"),
                        tokens=os.path.join(tts, "tokens.txt"),
                    ),
                    num_threads=4,
                )
            _tts = sx.OfflineTts(sx.OfflineTtsConfig(model=cfg, max_num_sentences=1))
    return _tts


def transcribe(path):
    global _asr
    with _lock:
        if _asr is None:
            sx = _sherpa()
            _asr = sx.OfflineRecognizer.from_sense_voice(
                model=os.path.join(VOICE, "asr", "model.int8.onnx"),
                tokens=os.path.join(VOICE, "asr", "tokens.txt"),
                use_itn=True,
                language="zh",
                num_threads=2,
            )
    import numpy as np

    with wave.open(path) as w:
        sr = w.getframerate()
        pcm = w.readframes(w.getnframes())
    if not pcm:
        return ""
    samples = np.frombuffer(pcm, dtype="<i2").astype("float32") / 32768.0
    s = _asr.create_stream()
    s.accept_waveform(sr, samples)
    _asr.decode_stream(s)
    return s.result.text.strip()


def synth(text, out):
    """Write one sentence to a 16-bit wav; returns its duration in seconds."""
    import array

    spoken = speakable(text)
    if not spoken.strip("" + "".join(TTS_CJK) + " .,!?;:'\"()-/+="):
        return 0.0
    speed = TTS_SPEED or (1.0 if tts_engine() == "matcha" else 1.3)
    with _gen:
        audio = speech_engine().generate(spoken, sid=0, speed=speed)
    gain = (
        float(os.environ["NPU_LLM_TTS_GAIN"])
        if os.environ.get("NPU_LLM_TTS_GAIN")
        else TTS_GAIN.get(tts_engine(), 1.0)
    )
    samples = [x * gain for x in audio.samples]
    peak = max((abs(x) for x in samples), default=0.0)
    if peak > TTS_PEAK:
        samples = [x * TTS_PEAK / peak for x in samples]
    a = array.array("h", (int(max(-1.0, min(1.0, x)) * 32767) for x in samples))
    with wave.open(out, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(audio.sample_rate)
        w.writeframes(a.tobytes())
    return len(a) / audio.sample_rate


def player():
    for c in ("pw-play", "aplay"):
        if shutil.which(c):
            return [c]
    return None


def recorder():
    if shutil.which("pw-record"):
        return ["pw-record", "--rate", "16000", "--channels", "1", "--format", "s16"]
    if shutil.which("arecord"):
        return ["arecord", "-q", "-f", "S16_LE", "-r", "16000", "-c", "1", "-t", "wav"]
    return None


def new_sentences(text, pos):
    """Sentences completed after pos; the trailing partial stays buffered.

    Only "N." inside a number would trip the latin full stop, so it needs a
    following space to count as an end of sentence.
    """
    out, start = [], pos
    for i in range(pos, len(text)):
        ch = text[i]
        end = ch in ENDERS or (ch == "." and i + 1 < len(text) and text[i + 1].isspace())
        if end:
            piece = text[start : i + 1].strip()
            if len(piece) > 1:
                out.append(piece)
            start = i + 1
    return out, start


class Speaker:
    """Synthesise and play sentence by sentence while the LLM is still writing."""

    def __init__(self):
        self.q = queue.Queue()
        self.serial = 0
        self.p = None
        self.active = False
        self.t = threading.Thread(target=self._run, daemon=True)
        self.t.start()

    def idle(self):
        """True once every queued sentence has finished playing."""
        return not self.active and self.q.empty()

    def say(self, text):
        if text.strip():
            self.q.put((self.serial, text.strip()))

    def close(self):
        """Join the worker before the process exits: if the interpreter tears
        down while an onnxruntime session is initialising, the C++ side aborts
        ("GetElementType is not implemented" then "terminate called")."""
        self.cancel()
        self.q.put((self.serial, None))
        self.t.join(5)

    def cancel(self):
        self.serial += 1
        while True:
            try:
                self.q.get_nowait()
            except queue.Empty:
                break
        p, self.p = self.p, None
        if p is not None and p.poll() is None:
            p.kill()

    def _run(self):
        cmd = player()
        while True:
            serial, text = self.q.get()
            if text is None:
                return
            if serial != self.serial or cmd is None:
                continue
            fn = os.path.join(tempfile.gettempdir(), f"npu-chat-say-{serial}.wav")
            dbg = os.environ.get("NPU_LLM_DEBUG")
            self.active = True
            try:
                secs = synth(text, fn)
            except Exception as e:  # a broken TTS model must not kill the GUI
                print(f"npu-chat: tts failed: {e}", file=sys.stderr)
                self.active = False
                continue
            if dbg:
                print(f"npu-chat: say {len(text)}ch -> {secs:.2f}s", file=sys.stderr)
            if serial != self.serial or secs <= 0:
                self.active = False
                continue
            self.p = subprocess.Popen(
                cmd + [fn], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                preexec_fn=_die_with_parent,
            )
            rc = self.p.wait()
            if dbg:
                print(f"npu-chat: play rc={rc} {cmd[0]}", file=sys.stderr)
            self.p = None
            self.active = False
            try:
                os.unlink(fn)
            except OSError:
                pass


def tail_rms(path, ms=200):
    """RMS of the last `ms` of a wav that is still being written, else None."""
    try:
        with open(path, "rb") as f:
            end = f.seek(0, os.SEEK_END)
            if end < 44 + 3200:
                return None
            f.seek(max(44, end - ms * 32))  # 16 kHz s16 mono = 32 bytes/ms
            raw = f.read()
    except OSError:
        return None
    a = array.array("h")
    a.frombytes(raw[: len(raw) & ~1])
    return (sum(x * x for x in a) / len(a)) ** 0.5 if a else None


class Recorder:
    """Push to talk: start on the first click, stop on the second."""

    def __init__(self, path="/tmp/npu-chat-utt.wav"):
        self.path = path
        self.p = None

    def start(self):
        cmd = recorder()
        if cmd is None:
            raise RuntimeError("需要 pw-record 或 arecord")
        self.p = subprocess.Popen(
            cmd + [self.path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            preexec_fn=_die_with_parent,
        )

    def stop(self):
        p, self.p = self.p, None
        if p is not None and p.poll() is None:
            p.send_signal(signal.SIGINT)  # both tools finalise the wav header here
            try:
                p.wait(3)
            except subprocess.TimeoutExpired:
                p.kill()
                p.wait()
        return self.path


