            pop = Gtk.Popover()
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            box.set_margin_top(6)
            box.set_margin_bottom(6)
            for n in names:
                b = Gtk.Button(label=n)
                b.add_css_class("flat")
                b.connect("clicked", lambda _b, n=n: self.pick(n, pop))
                b.set_halign(Gtk.Align.FILL)
                box.append(b)
            pop.set_child(box)
            self.chip.set_popover(pop)
        head.append(self.chip)
        col.append(head)

        # ---- messages
        self.scroll = Gtk.ScrolledWindow()
        self.scroll.set_vexpand(True)
        self.scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.list.set_margin_top(8)
        self.list.set_margin_bottom(8)
        self.scroll.set_child(self.list)
        col.append(self.scroll)

        self.history = []
        self.busy = False
        self.rec = None
        self.hold = 0
        self.cap = 0
        self.vstop = None
        self.speaker = None
        self.speech_pos = 0
        self.show_welcome()

        # ---- input
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        bar.set_margin_top(6)
        bar.set_margin_bottom(4)
        self.entry = Gtk.Entry()
        self.entry.add_css_class("entry")
        self.entry.set_placeholder_text("输入消息，或按住 ↑ 说话…")
        self.entry.set_hexpand(True)
        self.entry.connect("activate", self.send)
        self.send_btn = Gtk.Button(label="↑")
        self.send_btn.add_css_class("send")
        self.send_btn.set_tooltip_text("点一下发送，按住说话")
        hold = Gtk.GestureClick()
        hold.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        hold.connect("pressed", self.talk_press)
        hold.connect("released", self.talk_release)
        self.send_btn.add_controller(hold)
        bar.append(self.entry)
        bar.append(self.send_btn)
        self.cont_btn = Gtk.ToggleButton(label="🔁 连续对话")
        self.cont_btn.add_css_class("chip")
        self.cont_btn.set_sensitive(voice_ready())
        self.cont_btn.set_tooltip_text("回答读完自动再次开麦，接着问下一句")
        self.cont_btn.connect("toggled", self.cont_toggled)
        bar.append(self.cont_btn)
        col.append(bar)

        self.status = Gtk.Label(label="就绪", xalign=0)
        self.status.add_css_class("status")
        col.append(self.status)

        key = Gtk.EventControllerKey()
        key.connect("key-pressed", self.on_key)
        self.win.add_controller(key)

        self.win.present()
        self.entry.grab_focus()
        if self.ask_text:
            GLib.timeout_add(200, lambda: (self.fire(self.ask_text), False)[1])
        elif self.shot:
            GLib.timeout_add(1500, self.take_shot)

    def quit(self):
        if self.speaker is not None:
            self.speaker.close()
        super().quit()

    def take_shot(self):
        """--shot PATH: render the window to a PNG (kiosk diagnostics)."""
        w, h = self.win.get_width(), self.win.get_height()
        snap = Gtk.Snapshot()
        Gtk.WidgetPaintable.new(self.win).snapshot(snap, w, h)
        node = snap.to_node()
        rect = Graphene.Rect().init(0, 0, w, h)
        tex = Gtk.Native.get_renderer(self.win).render_texture(node, rect)
        tex.save_to_png(self.shot)
        print(f"wrote {self.shot} ({w}x{h})")
        self.quit()
        return False

    # ------------------------------------------------------------------ voice
    LONG_PRESS = 350  # ms on the send button before it starts listening

    def cont_toggled(self, btn):
        if btn.get_active():
            if voice_ready():
                self.speak_btn.set_active(True)  # a hands-free loop has to talk back
            self.status.set_text("连续对话：回答读完自动开麦")
            if not self.busy:
                self.next_turn()
        elif self.vstop is not None:
            self.vstop.set()  # cut the hands-free listen; ASR still runs

    def next_turn(self):
        """After a turn finishes, reopen the mic once the answer stopped playing."""
        if not self.cont_btn.get_active() or not voice_ready():
            return False
        if self.busy or self.rec is not None:
            return False
        sp = self.speaker
        if sp is not None and not sp.idle():
            GLib.timeout_add(400, self.next_turn)
            return False
        self._auto_listen()
        return False

    def _auto_listen(self):
        if not self.cont_btn.get_active() or self.busy or self.rec is not None:
            return False
        self.hush()  # playback and capture share the PipeWire graph
        try:
            rec = Recorder()
            rec.start()
        except Exception as e:
            self.status.set_text(f"录音失败：{e}")
            return False
        self.rec = rec
        self.vstop = threading.Event()
        self.send_btn.set_label("●")
        self.send_btn.add_css_class("listening")
        self.status.set_text("在听…说完自动发送")
        threading.Thread(target=self._vad, args=(rec, self.vstop), daemon=True).start()
        return False

    def _vad(self, rec, stop):
        """End the utterance on trailing silence; 20 s hard cap."""
        deadline = time.monotonic() + 20
        spoke, quiet = False, 0.0
        while not stop.is_set() and time.monotonic() < deadline:
            time.sleep(0.2)
            rms = tail_rms(rec.path)
            if rms is None:
                continue
            if rms >= SPEECH_RMS:
                spoke, quiet = True, 0.0
            elif spoke:
                quiet += 0.2
                if quiet >= SILENCE_S:
                    break
        if self.rec is rec:
            self.rec = None
            rec.stop()
            GLib.idle_add(self._auto_done, rec.path)
        return

    def _auto_done(self, path):
        self.vstop = None
        self.send_btn.set_label("↑")
        self.send_btn.remove_css_class("listening")
        self.status.set_text("识别中…")
        threading.Thread(target=self._hear, args=(path,), daemon=True).start()
        return False

    def talk_press(self, *_):
        """Press and hold ↑ to talk: recording starts once the press sticks."""
        if self.rec is not None:
            if self.vstop is not None:  # hands-free listen: tap to go straight to ASR
                self.vstop.set()
            return
        if self.busy or not voice_ready():
            return
        self.hold = GLib.timeout_add(self.LONG_PRESS, self._start_talk)

    def _start_talk(self):
        self.hold = 0
        if self.busy:
            return False
        self.hush()  # playback and capture share the PipeWire graph
        try:
            self.rec = Recorder()
            self.rec.start()
        except Exception as e:
            self.rec = None
            self.status.set_text(f"录音失败：{e}")
            return False
        self.send_btn.set_label("●")
        self.send_btn.add_css_class("listening")
        self.status.set_text("正在听…松开发送")
        # a lost release (finger off the screen) must not record until the app dies
        self.cap = GLib.timeout_add_seconds(60, self._talk_cap)
        return False

    def _talk_cap(self):
        self.cap = 0
        self.talk_release()
        return False

    def talk_release(self, *_):
        if self.cap:
            GLib.source_remove(self.cap)
            self.cap = 0
        if self.hold:
            GLib.source_remove(self.hold)
            self.hold = 0
            self.send()  # a plain tap still sends, and the mic never opened
            return
        rec, self.rec = self.rec, None
        if rec is None:
            return
        self.send_btn.set_label("↑")
        self.send_btn.remove_css_class("listening")
        path = rec.stop()
        self.status.set_text("识别中…")
        threading.Thread(target=self._hear, args=(path,), daemon=True).start()

    def _hear(self, path):
        text, err = "", None
        try:
            text = transcribe(path)
        except Exception as e:  # model missing, no audio, ...
            err = str(e)
        GLib.idle_add(self._heard, text, err)

    def _heard(self, text, err):
        if err:
            self.status.set_text(f"识别失败：{err}")
        elif not text:
            self.status.set_text("没听清，再说一次")
            if self.cont_btn.get_active():
                GLib.timeout_add(600, self._auto_listen)
        else:
            self.status.set_text(f"听到：{text}")
            # a spoken question always gets a spoken answer
            if voice_ready():
                self.speak_btn.set_active(True)
            self.fire(text)
        return False

    def feed_speech(self, full):
        """Hand every finished sentence to the speaker while text still streams."""
        if not self.speak_btn.get_active() or not voice_ready():
            return
        if self.speaker is None:
            self.speaker = Speaker()
        parts, self.speech_pos = new_sentences(full, self.speech_pos)
        for p in parts:
            self.speaker.say(p)

    def hush(self):
        if self.speaker is not None:
            self.speaker.cancel()

    def pick(self, name, pop):
        self.model = name
        self.chip.set_label(name)
        pop.popdown()
        self.status.set_text(f"已切换到 {name}")

    def stop(self, *_):
        """Cut the turn short. SIGINT first; genie usually exits in ~0.1 s and the
        DSP is free for the next turn, SIGKILL is only a backstop."""
        p = getattr(self, "job", {}).get("p")
        self.hush()
        if p is None or p.poll() is not None:
            self.status.set_text("已停止朗读")
            return
        self.job["stop"] = True
        p.send_signal(signal.SIGINT)

        def backstop():
            if p.poll() is None:
                p.kill()
            return False

        GLib.timeout_add(2000, backstop)
        self.status.set_text("正在停止…")

    def clear(self, *_):
        if getattr(self, "busy", False):
            return
        self.hush()
        while self.list.get_first_child() is not None:
            self.list.remove(self.list.get_first_child())
        self.history = []
        self.welcome = None
        self.show_welcome()
        self.status.set_text("已清空")

    def on_key(self, _c, keyval, _code, _mods):
        if keyval == 0xFF1B:  # Escape
            self.quit()
            return True
        return False

    def show_welcome(self):
        w = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        w.set_valign(Gtk.Align.CENTER)
        w.set_margin_top(40)
        w.set_margin_bottom(40)
        t = Gtk.Label(label="问点什么吧", xalign=0.5)
        t.add_css_class("welcome")
        s = Gtk.Label(label="Qwen2.5-0.5B · Llama-3.2-1B 跑在 NPU 上，不联网", xalign=0.5)
        s.add_css_class("subtitle")
        w.append(t)
        w.append(s)
        chips = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        chips.set_halign(Gtk.Align.CENTER)
        chips.set_margin_top(10)
        for h in SEND_HINTS:
            b = Gtk.Button(label=h)
            b.add_css_class("hint")
            b.connect("clicked", lambda _b, h=h: self.fire(h))
            chips.append(b)
        w.append(chips)
        self.welcome = w
        self.list.append(w)

    def bubble(self, text, user, meta=None):
        row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        card.add_css_class("card-user" if user else "card-bot")
        label = Gtk.Label(label=text, xalign=0, yalign=0)
        label.set_wrap(True)
        label.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
        label.set_max_width_chars(62)
        label.set_selectable(True)
        label.add_css_class("bub-user" if user else "bub-bot")
        card.append(label)
        row.append(card)
        row.set_halign(Gtk.Align.END if user else Gtk.Align.START)
        if meta:
            m = Gtk.Label(label=meta, xalign=1 if user else 0)
            m.add_css_class("meta")
            row.append(m)
        self.list.append(row)
        self.glide()
        return label

    def glide(self):
        GLib.idle_add(self._scroll_bottom)

    def _scroll_bottom(self):
        adj = self.scroll.get_vadjustment()
        adj.set_value(adj.get_upper())
        return False

    def error(self, msg):
        row = Gtk.Box()
        card = Gtk.Box()
        card.add_css_class("card-bot")
        l = Gtk.Label(label=msg, xalign=0)
        l.set_wrap(True)
        l.set_max_width_chars(62)
        l.add_css_class("err")
        card.append(l)
        row.append(card)
        row.set_halign(Gtk.Align.START)
        self.list.append(row)
        self.glide()

    # ------------------------------------------------------------------ turn
    def fire(self, text):
        self.entry.set_text(text)
        self.send()

    def send(self, *_):
        text = self.entry.get_text().strip()
        if not text or self.model is None:
            return
        if getattr(self, "busy", False):
            return
        if getattr(self, "welcome", None) is not None:
            self.list.remove(self.welcome)
            self.welcome = None

        self.entry.set_text("")
        self.busy = True
        self.job = {"p": None, "stop": False}
        self.speech_pos = 0
        self.hush()
        self.send_btn.set_sensitive(False)
        self.stop_btn.set_sensitive(True)
        self.chip.add_css_class("busy")
        self.bubble(text, True)
        self.history.append(("user", text))

        card = Gtk.Box()
        card.add_css_class("card-bot")
        body = Gtk.Label(label="●", xalign=0, yalign=0)
        body.add_css_class("typing")
        card.append(body)
        holder = Gtk.Box()
        holder.append(card)
        holder.set_halign(Gtk.Align.START)
        self.list.append(holder)
        self.glide()

        phase = {"i": 0, "t0": time.monotonic(), "got": 0}

        def show(txt):
            if not phase["got"]:
                # first chunk: the dots become the answer
                body.remove_css_class("typing")
                body.add_css_class("bub-bot")
                body.set_wrap(True)
                body.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
                body.set_max_width_chars(62)
                body.set_selectable(True)
            phase["got"] = len(txt)
            body.set_text(txt)
            self.feed_speech(txt)
            self.glide()
            return False

        def tick():
            if not self.busy:
                return False
            el = max(time.monotonic() - phase["t0"], 0.001)
            if phase["got"]:
                self.status.set_text(
                    f"{self.model} 生成中  {el:0.1f}s  约 {tokens(body.get_text()) / el:0.1f} tok/s"
                )
            else:
                body.set_text(["●", "●●", "●●●"][phase["i"] % 3])
                self.status.set_text(f"{self.model} 正在 NPU 上生成…  {el:0.1f}s")
            phase["i"] += 1
            return True

        timer = GLib.timeout_add(250, tick)

        def work():
            prompt = build_prompt(self.model, self.history)
            txt, err, dt, stopped = ask(
                self.model, prompt, on_chunk=lambda t: GLib.idle_add(show, t), job=self.job
            )
            GLib.idle_add(done, txt, err, dt, stopped)

        def done(txt, err, dt, stopped):
            GLib.source_remove(timer)
            self.busy = False
            self.send_btn.set_sensitive(True)
            self.stop_btn.set_sensitive(False)
            self.chip.remove_css_class("busy")
            if err:
                self.list.remove(holder)
                self.error(f"推理失败：{err}")
                self.status.set_text("失败")
                return False
            if not txt:
                self.list.remove(holder)
                self.status.set_text("已停止")
                return False
            show(txt)
            self.history.append(("assistant", txt))
            tail = txt[self.speech_pos :].strip()
            if tail and self.speak_btn.get_active() and voice_ready():
                if self.speaker is None:
                    self.speaker = Speaker()
                self.speaker.say(tail)
                self.speech_pos = len(txt)
            approx = tokens(txt) / dt if dt > 0 else 0
            tag = "已停止" if stopped else f"{dt:0.1f}s"
            self.status.set_text(f"{self.model}  ·  {tag}  ·  约 {approx:0.1f} tok/s")
            if self.ask_text:
                print(f"ANSWER ({dt:0.1f}s): {txt}\nSTATUS: {self.status.get_text()}")
                if self.shot:
                    GLib.timeout_add(1800, self.take_shot)
                else:
                    self.quit()
            else:
                GLib.timeout_add(200, self.next_turn)
            return False

        threading.Thread(target=work, daemon=True).start()


def selftest():
    q = build_prompt("qwen2.5-0.5b", [("user", "hi"), ("assistant", "yo"), ("user", "ok")])
    assert q.endswith("<|im_start|>assistant\n"), q
    assert "<|im_start|>user\nhi<|im_end|>" in q
    l = build_prompt("llama3.2-1b", [("user", "hi")])
    assert l.startswith("<|start_header_id|>user<|end_header_id|>\n\nhi<|eot_id|>"), l
    assert l.endswith("<|start_header_id|>assistant<|end_header_id|>\n\n"), l
    # trimming keeps the newest turn and stays under budget
    long_hist = [("user", "x" * 1000), ("assistant", "y" * 1000), ("user", "last")]
    t = build_prompt("qwen2.5-0.5b", long_hist)
    assert "last" in t and len(t) < 1900, len(t)
    assert extract("junk\n[BEGIN]: hello\nworld[END]\nnoise rpcmem\n") == ("hello\nworld", None)
    # streaming: the buffer is re-extracted while generation is still running, so
    # a missing [END] must still yield the text received so far
    assert extract("banner\n[BEGIN]: 大海是")[0] == "大海是"
    assert extract("noise only")[0] is None
    t, e = extract("some error: boom")
    assert t is None and "error" in e, (t, e)
    assert abs(tokens("hello world") - 2.75) < 0.01, tokens("hello world")
    assert abs(tokens("秋天") - 2) < 0.01, tokens("秋天")

    # voice: finished sentences leave the buffer, the tail stays for the next
    # chunk, and decimals are not mistaken for sentence ends
    assert new_sentences("今天晴。气温二十度", 0) == (["今天晴。"], 4)
    assert new_sentences("今天晴。气温二十度。", 4) == (["气温二十度。"], 10)
    assert new_sentences("你好", 0) == ([], 0)
    assert new_sentences("pi is 3.14 ok. done", 0) == (["pi is 3.14 ok."], 14)
    assert new_sentences("雨。", 0)[0] == ["雨。"]
    assert cn_number("0") == "零"
    assert cn_number("12") == "十二"
    assert cn_number("105") == "一百零五"
    assert cn_number("2024") == "二千零二十四"
    assert cn_number("123456") == "一二三四五六"
    if voice_ready():
        assert speakable("他买了10个面包。") == "他买了十个面包。"
        assert speakable("3+2=5") == "三加二等于五"
        assert speakable("温度25℃") == "温度二十五"
        assert speakable("湿度60%") == "湿度百分之六十"
        assert speakable("%") == "百分之"
        assert speakable("<|endoftext|>") == ""
    # hands-free VAD: read the tail of a wav that is still being written
    p = os.path.join(tempfile.gettempdir(), "npu-chat-rms.wav")
    with open(p, "wb") as f:
        f.write(b"\0" * 44)
        f.write(array.array("h", [0] * 1600 + [1000] * 1600).tobytes())
    assert 600 < tail_rms(p) < 800, tail_rms(p)
    assert tail_rms("/dev/null") is None
    os.unlink(p)
    print("selftest ok")


def voice_selftest(seconds=4):
    """End-to-end check without the GUI: record, transcribe, then speak."""
    if not voice_ready():
        print(f"voice payload missing under {VOICE}")
        return 1
    print("recorder:", recorder(), "player:", player())
    r = Recorder("/tmp/npu-chat-selftest.wav")
    r.start()
    print(f"recording {seconds}s — say something now")
    time.sleep(seconds)
    path = r.stop()
    t0 = time.monotonic()
    text = transcribe(path)
    print(f"ASR {time.monotonic() - t0:0.2f}s: {text!r}")
    out = "/tmp/npu-chat-selftest-tts.wav"
    t0 = time.monotonic()
    secs = synth("语音链路正常。", out)
    dt = time.monotonic() - t0
    print(f"TTS {dt:0.2f}s for {secs:0.2f}s audio ({secs / dt:0.2f}x real time)")
    cmd = player()
    if cmd:
        t0 = time.monotonic()
        subprocess.run(cmd + [out], check=False)
        print(f"played in {time.monotonic() - t0:0.2f}s")
    return 0


if __name__ == "__main__":
    if "--selftest" in sys.argv:
        selftest()
        sys.exit(0)
    if "--voice-selftest" in sys.argv:
        i = sys.argv.index("--voice-selftest")
        try:
            sys.exit(voice_selftest(int(sys.argv[i + 1])))
        except (IndexError, ValueError):
            sys.exit(voice_selftest())
    shot = None
    if "--shot" in sys.argv:
        shot = sys.argv[sys.argv.index("--shot") + 1]
    ask_text = None
    if "--ask" in sys.argv:
        ask_text = sys.argv[sys.argv.index("--ask") + 1]
    if "--model" in sys.argv:
        want = sys.argv[sys.argv.index("--model") + 1]
    else:
        want = None
    app = Chat(application_id="org.quectel.NpuChat")
    app.shot = shot
    app.ask_text = ask_text
    app.want_model = want
    app.run([])
