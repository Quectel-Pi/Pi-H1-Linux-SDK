SEND_HINTS = ["介绍一下你自己", "用三句话描述大海", "写一首关于秋天的短诗", "什么是 Hexagon NPU？"]

# prompt budget in chars, sized to the model's context window
BUDGET = {"qwen": 1700, "llama": 6000}


def family(name):
    return "llama" if "llama" in name.lower() else "qwen"


def build_prompt(model, history):
    """history: [(role, text)] -> prompt string in the model's chat format."""
    fam = family(model)
    budget = BUDGET[fam]
    turns = list(history)
    while len(turns) > 1 and sum(len(t) for _, t in turns) > budget:
        turns.pop(0)
    if fam == "llama":
        out = "".join(
            f"<|start_header_id|>{r}<|end_header_id|>\n\n{t}<|eot_id|>" for r, t in turns
        )
        return out + "<|start_header_id|>assistant<|end_header_id|>\n\n"
    out = "".join(f"<|im_start|>{r}\n{t}<|im_end|>\n" for r, t in turns)
    return out + "<|im_start|>assistant\n"


def extract(out):
    """Pull the answer out of genie-t2t-run's stdout (noise + [BEGIN]/[END])."""
    if "[BEGIN]:" not in out:
        bad = [ln for ln in out.splitlines() if "rror" in ln or "ailed" in ln]
        return None, (bad[0] if bad else out.strip()[-300:])
    body = out.split("[BEGIN]:", 1)[1]
    if "[END]" in body:
        body = body.split("[END]", 1)[0]
    text = "\n".join(
        ln for ln in body.splitlines() if "rpcmem" not in ln and "/prj/qct/" not in ln
    )
    return text.strip(), None


def models():
    try:
        names = sorted(os.listdir(DATA))
    except OSError:
        return []
    return [n for n in names if os.path.isfile(os.path.join(DATA, n, "model-config.json"))]


def tokens(text):
    """Rough token count: CJK is ~1 token per char, latin ~4 chars per token."""
    cjk = sum(1 for ch in text if ord(ch) > 0x2E7F)
    return cjk + (len(text) - cjk) / 4.0


def ask(model, prompt, on_chunk=None, job=None):
    """Run one turn, streaming. Returns (text, error, seconds, stopped).

    on_chunk(text) is called from this thread with the answer so far, so the
    caller must marshal to the main loop. job is a dict the caller can use to
    cancel: job["p"] holds the child, job["stop"] says a stop was asked for.
    """
    d = os.path.join(DATA, model)
    env = dict(os.environ)
    env["LD_LIBRARY_PATH"] = ROOT + (":" + env["LD_LIBRARY_PATH"] if env.get("LD_LIBRARY_PATH") else "")
    env["ADSP_LIBRARY_PATH"] = ROOT + (":" + env["ADSP_LIBRARY_PATH"] if env.get("ADSP_LIBRARY_PATH") else "")
    t0 = time.monotonic()
    p = subprocess.Popen(
        ["stdbuf", "-o0", "-e0", os.path.join(ROOT, "genie-t2t-run"), "-c", "model-config.json",
         "-p", prompt],
        cwd=d, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, bufsize=0,
        preexec_fn=_die_with_parent,
    )
    if job is not None:
        job["p"] = p
    raw = bytearray()
    text = ""
    try:
        while True:
            chunk = p.stdout.read(4096)
            if not chunk:
                break
            raw += chunk
            # Re-extract from everything so far: extract() already knows how to
            # skip the rpcmem banner and stop at [END], and on a truncated
            # buffer it just returns the text without the closing marker.
            sofar, _ = extract(raw.decode("utf-8", "replace"))
            if sofar and sofar != text:
                text = sofar
                if on_chunk:
                    on_chunk(text)
    finally:
        p.wait()
        if job is not None:
            job["p"] = None
    dt = time.monotonic() - t0
    stopped = bool(job and job.get("stop"))
    if text:
        return text, None, dt, stopped
    _, err = extract(raw.decode("utf-8", "replace"))
    if stopped:
        return "", None, dt, True
    return "", err or f"genie-t2t-run exited {p.returncode}", dt, False


try:
    _PRCTL = ctypes.CDLL("libc.so.6", use_errno=True).prctl
except (OSError, AttributeError):
    _PRCTL = None


def _die_with_parent():
    """Kill the model process if the GUI dies; an orphaned genie holds the DSP
    and the next run fails with 'Failed to create device: 14001' until reboot.
    Runs in the forked child, so libc is loaded above, not here."""
    if _PRCTL:
        try:
            _PRCTL(1, signal.SIGKILL)  # PR_SET_PDEATHSIG
        except Exception:
            pass


class Chat(Gtk.Application):
    shot = None
    ask_text = None
    want_model = None

    def do_activate(self):
