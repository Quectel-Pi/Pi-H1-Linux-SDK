# prompt budget in chars, sized to the model's context window
BUDGET = {"qwen": 1700, "llama": 6000}


def family(name):
    return "llama" if "llama" in name.lower() else "qwen"


def build_prompt(model, history):
    """history: [(role, text)] -> prompt string in the model's chat format."""
    fam = family(model)
    budget = BUDGET[fam]
    turns = list(history)
    while len(turns) > 1 and sum(len(t) for _, t in turns) > budget:
        turns.pop(0)
    if fam == "llama":
        out = "".join(
            f"<|start_header_id|>{r}<|end_header_id|>\n\n{t}<|eot_id|>" for r, t in turns
        )
        return out + "<|start_header_id|>assistant<|end_header_id|>\n\n"
    out = "".join(f"<|im_start|>{r}\n{t}<|im_end|>\n" for r, t in turns)
    return out + "<|im_start|>assistant\n"


def extract(out):
    """Pull the answer out of genie-t2t-run's stdout (noise + [BEGIN]/[END])."""
    if "[BEGIN]:" not in out:
        bad = [ln for ln in out.splitlines() if "rror" in ln or "ailed" in ln]
        return None, (bad[0] if bad else out.strip()[-300:])
    body = out.split("[BEGIN]:", 1)[1]
    if "[END]" in body:
        body = body.split("[END]", 1)[0]
    text = "\n".join(
        ln for ln in body.splitlines() if "rpcmem" not in ln and "/prj/qct/" not in ln
    )
    return text.strip(), None


def models():
    try:
        names = sorted(os.listdir(DATA))
    except OSError:
        return []
    return [n for n in names if os.path.isfile(os.path.join(DATA, n, "model-config.json"))]


def tokens(text):
    """Rough token count: CJK is ~1 token per char, latin ~4 chars per token."""
    cjk = sum(1 for ch in text if ord(ch) > 0x2E7F)
    return cjk + (len(text) - cjk) / 4.0


def ask(model, prompt, on_chunk=None, job=None):
    """Run one turn, streaming. Returns (text, error, seconds, stopped).

    on_chunk(text) is called from this thread with the answer so far, so the
    caller must marshal to the main loop. job is a dict the caller can use to
    cancel: job["p"] holds the child, job["stop"] says a stop was asked for.
    """
    d = os.path.join(DATA, model)
    env = dict(os.environ)
    env["LD_LIBRARY_PATH"] = ROOT + (":" + env["LD_LIBRARY_PATH"] if env.get("LD_LIBRARY_PATH") else "")
    env["ADSP_LIBRARY_PATH"] = ROOT + (":" + env["ADSP_LIBRARY_PATH"] if env.get("ADSP_LIBRARY_PATH") else "")
    t0 = time.monotonic()
    p = subprocess.Popen(
        ["stdbuf", "-o0", "-e0", os.path.join(ROOT, "genie-t2t-run"), "-c", "model-config.json",
         "-p", prompt],
        cwd=d, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, bufsize=0,
        preexec_fn=_die_with_parent,
    )
    if job is not None:
        job["p"] = p
    raw = bytearray()
    text = ""
    try:
        while True:
            chunk = p.stdout.read(4096)
            if not chunk:
                break
            raw += chunk
            # Re-extract from everything so far: extract() already knows how to
            # skip the rpcmem banner and stop at [END], and on a truncated
            # buffer it just returns the text without the closing marker.
            sofar, _ = extract(raw.decode("utf-8", "replace"))
            if sofar and sofar != text:
                text = sofar
                if on_chunk:
                    on_chunk(text)
    finally:
        p.wait()
        if job is not None:
            job["p"] = None
    dt = time.monotonic() - t0
    stopped = bool(job and job.get("stop"))
    if text:
        return text, None, dt, stopped
    _, err = extract(raw.decode("utf-8", "replace"))
    if stopped:
        return "", None, dt, True
    return "", err or f"genie-t2t-run exited {p.returncode}", dt, False


try:
    _PRCTL = ctypes.CDLL("libc.so.6", use_errno=True).prctl
except (OSError, AttributeError):
    _PRCTL = None


def _die_with_parent():
    """Kill the model process if the GUI dies; an orphaned genie holds the DSP
    and the next run fails with 'Failed to create device: 14001' until reboot.
    Runs in the forked child, so libc is loaded above, not here."""
    if _PRCTL:
        try:
            _PRCTL(1, signal.SIGKILL)  # PR_SET_PDEATHSIG
        except Exception:
            pass


# ---------------------------------------------------------------------- voice
# Offline ASR + TTS, nothing leaves the board: sherpa-onnx with SenseVoice small
# for speech in and VITS for speech out, both on the CPU while the LLM keeps the
# DSP. Measured on this board: ASR ~17x real time (0.3 s for 5.6 s of audio),
# TTS ~1.9x real time at 4 threads. Capture and playback use PipeWire
# (pw-record/pw-play) and fall back to ALSA (arecord/aplay).
VOICE = os.environ.get("NPU_LLM_VOICE", "/usr/share/npu-llm/voice")
SHERPA = os.environ.get("NPU_LLM_SHERPA", "/usr/lib/npu-llm/voice")
ASR_FILES = ("model.int8.onnx", "tokens.txt")
TTS_FILES = ("model.onnx", "lexicon.txt", "tokens.txt")
ENDERS = "。！？!?；;\n"
# hands-free listening: speech must cross SPEECH_RMS before trailing silence can
# end the utterance. Measured on this board: ambient ~40, normal speech ~400.
SPEECH_RMS = 150
SILENCE_S = 0.8
# VITS speaking rate; TTS_SPEED=1.5 is the fastest that still sounds natural.
TTS_SPEED = float(os.environ.get("NPU_LLM_TTS_SPEED", "1.3"))

_sx = None
_asr = None
_tts = None
_chars = None
_lock = threading.Lock()
_gen = threading.Lock()

DIGITS = "零一二三四五六七八九"
UNITS = ("", "十", "百", "千")
SAY_MAP = {"+": "加", "=": "等于", "×": "乘", "÷": "除以", "&": "和"}


def cn_number(s):
    """'12' -> 十二, '105' -> 一百零五; digit by digit past four places so
    years and long ids stay recognisable."""
    s = s.lstrip("0") or "0"
    if s == "0":
        return "零"
    if len(s) > 4:
        return "".join(DIGITS[int(c)] for c in s)
    out = []
    for i, ch in enumerate(s):
        v = int(ch)
        if v:
            out.append(DIGITS[v] + UNITS[len(s) - i - 1])
        elif out and out[-1] != "零":
            out.append("零")
    text = "".join(out).rstrip("零")
    return text[1:] if text.startswith("一十") else text


def _speakable_chars():
    """The VITS lexicon has no arabic digits and few symbols: anything outside
    its character set is dropped, digits are read out in Chinese."""
    global _chars
    if _chars is None:
        cs = set("，。！？、；：—…·")
        with open(os.path.join(VOICE, "tts", "lexicon.txt"), encoding="utf-8") as f:
            for line in f:
                if line.strip():
                    cs.add(line.split(" ", 1)[0])
        _chars = cs
    return _chars


def speakable(text):
    cs = _speakable_chars()
    out, i = [], 0
    while i < len(text):
        ch = text[i]
        if ch.isdigit():
            j = i
            while j < len(text) and text[j].isdigit():
                j += 1
            out.append(cn_number(text[i:j]))
            i = j
            continue
        if ch == "%":  # 60% reads as 百分之六十, so it goes in front of the number
            if out and out[-1] and out[-1][-1] in DIGITS + "十百千":
                out[-1] = "百分之" + out[-1]
            else:
                out.append("百分之")
            i += 1
            continue
        if ch in cs:
            out.append(ch)
        elif ch in SAY_MAP:
            out.append(SAY_MAP[ch])
        i += 1
    return "".join(out)


def voice_ready():
    return all(
        os.path.isfile(os.path.join(VOICE, d, f))
        for d, fs in (("asr", ASR_FILES), ("tts", TTS_FILES))
        for f in fs
    )


def _sherpa():
    global _sx
    if _sx is None:
        if SHERPA not in sys.path:
            sys.path.insert(0, SHERPA)
        import sherpa_onnx

        _sx = sherpa_onnx
    return _sx


def speech_engine():
    global _tts
    with _lock:
        if _tts is None:
            sx = _sherpa()
            cfg = sx.OfflineTtsConfig(
                model=sx.OfflineTtsModelConfig(
                    vits=sx.OfflineTtsVitsModelConfig(
                        model=os.path.join(VOICE, "tts", "model.onnx"),
                        lexicon=os.path.join(VOICE, "tts", "lexicon.txt"),
                        tokens=os.path.join(VOICE, "tts", "tokens.txt"),
                    ),
                    num_threads=4,  # 4 is the sweet spot here, 8 is slower
                ),
                max_num_sentences=1,
            )
            _tts = sx.OfflineTts(cfg)
    return _tts


def transcribe(path):
    global _asr
    with _lock:
        if _asr is None:
            sx = _sherpa()
            _asr = sx.OfflineRecognizer.from_sense_voice(
                model=os.path.join(VOICE, "asr", "model.int8.onnx"),
                tokens=os.path.join(VOICE, "asr", "tokens.txt"),
                use_itn=True,
                language="zh",
                num_threads=2,
            )
    import numpy as np

    with wave.open(path) as w:
        sr = w.getframerate()
        pcm = w.readframes(w.getnframes())
    if not pcm:
        return ""
    samples = np.frombuffer(pcm, dtype="<i2").astype("float32") / 32768.0
    s = _asr.create_stream()
    s.accept_waveform(sr, samples)
    _asr.decode_stream(s)
    return s.result.text.strip()


def synth(text, out):
    """Write one sentence to a 16-bit wav; returns its duration in seconds."""
    import array

    spoken = speakable(text)
    if not spoken.strip("，。！？、；：—…·"):
        return 0.0
    with _gen:
        audio = speech_engine().generate(spoken, sid=0, speed=TTS_SPEED)
    a = array.array("h", (int(max(-1.0, min(1.0, x)) * 32767) for x in audio.samples))
    with wave.open(out, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(audio.sample_rate)
        w.writeframes(a.tobytes())
    return len(a) / audio.sample_rate


def player():
    for c in ("pw-play", "aplay"):
        if shutil.which(c):
            return [c]
    return None


def recorder():
    if shutil.which("pw-record"):
        return ["pw-record", "--rate", "16000", "--channels", "1", "--format", "s16"]
    if shutil.which("arecord"):
        return ["arecord", "-q", "-f", "S16_LE", "-r", "16000", "-c", "1", "-t", "wav"]
    return None


def new_sentences(text, pos):
    """Sentences completed after pos; the trailing partial stays buffered.

    Only "N." inside a number would trip the latin full stop, so it needs a
    following space to count as an end of sentence.
    """
    out, start = [], pos
    for i in range(pos, len(text)):
        ch = text[i]
        end = ch in ENDERS or (ch == "." and i + 1 < len(text) and text[i + 1].isspace())
        if end:
            piece = text[start : i + 1].strip()
            if len(piece) > 1:
                out.append(piece)
            start = i + 1
    return out, start


class Speaker:
    """Synthesise and play sentence by sentence while the LLM is still writing."""

    def __init__(self):
        self.q = queue.Queue()
        self.serial = 0
        self.p = None
        self.active = False
        self.t = threading.Thread(target=self._run, daemon=True)
        self.t.start()

    def idle(self):
        """True once every queued sentence has finished playing."""
        return not self.active and self.q.empty()

    def say(self, text):
        if text.strip():
            self.q.put((self.serial, text.strip()))

    def close(self):
        """Join the worker before the process exits: if the interpreter tears
        down while an onnxruntime session is initialising, the C++ side aborts
        ("GetElementType is not implemented" then "terminate called")."""
        self.cancel()
        self.q.put((self.serial, None))
        self.t.join(5)

    def cancel(self):
        self.serial += 1
        while True:
            try:
                self.q.get_nowait()
            except queue.Empty:
                break
        p, self.p = self.p, None
        if p is not None and p.poll() is None:
            p.kill()

    def _run(self):
        cmd = player()
        while True:
            serial, text = self.q.get()
            if text is None:
                return
            if serial != self.serial or cmd is None:
                continue
            fn = os.path.join(tempfile.gettempdir(), f"npu-chat-say-{serial}.wav")
            dbg = os.environ.get("NPU_LLM_DEBUG")
            self.active = True
            try:
                secs = synth(text, fn)
            except Exception as e:  # a broken TTS model must not kill the GUI
                print(f"npu-chat: tts failed: {e}", file=sys.stderr)
                self.active = False
                continue
            if dbg:
                print(f"npu-chat: say {len(text)}ch -> {secs:.2f}s", file=sys.stderr)
            if serial != self.serial or secs <= 0:
                self.active = False
                continue
            self.p = subprocess.Popen(
                cmd + [fn], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                preexec_fn=_die_with_parent,
            )
            rc = self.p.wait()
            if dbg:
                print(f"npu-chat: play rc={rc} {cmd[0]}", file=sys.stderr)
            self.p = None
            self.active = False
            try:
                os.unlink(fn)
            except OSError:
                pass


def tail_rms(path, ms=200):
    """RMS of the last `ms` of a wav that is still being written, else None."""
    try:
        with open(path, "rb") as f:
            end = f.seek(0, os.SEEK_END)
            if end < 44 + 3200:
                return None
            f.seek(max(44, end - ms * 32))  # 16 kHz s16 mono = 32 bytes/ms
            raw = f.read()
    except OSError:
        return None
    a = array.array("h")
    a.frombytes(raw[: len(raw) & ~1])
    return (sum(x * x for x in a) / len(a)) ** 0.5 if a else None


class Recorder:
    """Push to talk: start on the first click, stop on the second."""

    def __init__(self, path="/tmp/npu-chat-utt.wav"):
        self.path = path
        self.p = None

    def start(self):
        cmd = recorder()
        if cmd is None:
            raise RuntimeError("需要 pw-record 或 arecord")
        self.p = subprocess.Popen(
            cmd + [self.path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            preexec_fn=_die_with_parent,
        )

    def stop(self):
        p, self.p = self.p, None
        if p is not None and p.poll() is None:
            p.send_signal(signal.SIGINT)  # both tools finalise the wav header here
            try:
                p.wait(3)
            except subprocess.TimeoutExpired:
                p.kill()
                p.wait()
        return self.path


