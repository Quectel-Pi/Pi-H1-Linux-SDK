[Unit]
Description=Voice input daemon (push-to-talk dictation)
Documentation=file:///usr/share/doc/pi-voice-input/README.md
# A desktop-session service, not a boot service: it needs the user's session
# bus and PipeWire. It is pulled in by graphical-session.target, i.e. once per
# graphical login, and stopped with that session.
#
# WantedBy=default.target was wrong and measurably so: systemd --user keeps the
# user manager (and therefore default.target) alive across a logout, so logging
# back in did not re-pull this unit and the daemon stayed dead -- push-to-talk
# and the switch were both gone until the next reboot. graphical-session.target
# has StopWhenUnneeded=yes and is re-activated by every GNOME login, which is
# exactly the lifetime this service needs. PartOf= makes it stop at logout.
#
# At login the daemon reads the remembered switch position (StateDirectory=
# below) and loads the model itself if it was left on -- an "off" choice must
# stay off across a reboot, otherwise the freed 350 MB comes back on its own.
After=pipewire.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/pi-voice-inputd
Restart=on-failure
RestartSec=2

# The ASR model is ~250 MB of int8 weights plus onnxruntime arenas once loaded;
# it is freed again when the switch is turned off, so this is a ceiling, not a
# steady-state figure.
MemoryMax=1G

# Speech recognition on the CPU while the LLM owns the HTP: keep it on the
# little cores so a dictation never competes with generation on 4-7.
CPUAffinity=0-3
Nice=5

# Where the switch position is remembered between sessions: systemd creates
# ~/.local/state/pi-voice-input and exports it as $STATE_DIRECTORY. ProtectHome
# would otherwise make the home directory read-only and the switch would forget
# its position at every login.
StateDirectory=pi-voice-input

# Microphone via ALSA/PipeWire as the logged-in user; no root, no devices.
NoNewPrivileges=yes
# PrivateTmp is deliberately NOT set: systemd 259 on this image fails to spawn
# a user unit that has it ("Failed to spawn 'start' task: Permission denied",
# Result=resources), measured on the board. Adding it back makes the service
# never start.
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/user/%U

[Install]
WantedBy=graphical-session.target
