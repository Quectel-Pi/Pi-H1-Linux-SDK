#: /home/igni/Downloads/debian/1.7-QuecPi-QCLinux-BL01/layers/meta-quectel/recipes-quectel/pi-agent-setup/files/pi-agent-setup.py
msgid ""
"安装完成后这样开始用 pi：\n"
"\n"
"  1. 打开终端（Ctrl+Alt+T，或在应用列表里找“终端”）\n"
"  2. 进入你要工作的目录，例如：\n"
"       cd ~/my-project\n"
"  3. 输入 pi 回车\n"
"\n"
"进入 pi 之后：\n"
"  /model    切换模型\n"
"  /login    更换 API Key 或用账号登录\n"
"  /help     查看全部命令\n"
"  Ctrl+C    退出（会话会自动保存，pi -c 继续上次对话）\n"
"\n"
"配置文件都在 ~/.pi/agent/ 下：\n"
"  models.json    端点与模型\n"
"  auth.json      API Key（权限 600）\n"
"  settings.json  默认模型与扩展\n"
msgstr ""

